import { Palette } from "std-widgets.slint";
import { Metrics, Colors } from "tokens.slint";
import { Icon, TablerIcons } from "@origami-icons/icons.slint";

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    in property <color> tint: Palette.foreground;
    callback clicked();

    width: Metrics.touch;
    height: 100%;
    min-height: Metrics.touch;

    circle := Rectangle {
        width: Metrics.touch;
        height: Metrics.touch;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: touch.pressed && root.enabled ? Palette.foreground.with-alpha(0.14) : transparent;

        Icon {
            source: root.icon;
            color: root.enabled ? root.tint : Colors.muted.with-alpha(0.35);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component TopBar inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <string> title;
    in property <string> subtitle;
    in property <brush> bar-background: Colors.surface;
    // Slots for the buttons at either end.
    height: root.inset-top + Metrics.bar-height;
    background: root.bar-background;

    VerticalLayout {
        padding-top: root.inset-top;
        HorizontalLayout {
            height: Metrics.bar-height;
            padding-left: Metrics.spacing-md;
            padding-right: Metrics.spacing-md;
            spacing: Metrics.spacing-sm;
            @children
        }
    }
}

// Circular bubble button for headers
export component BubbleButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    in property <color> tint: Palette.foreground;
    in property <bool> spinning: false;
    callback clicked();

    property <angle> spin-angle: root.spinning ? mod(animation-tick(), 1s) / 1s * 360deg : 0deg;

    width: Metrics.bubble-button-size;
    height: 100%;
    min-height: Metrics.touch;

    bubble := Rectangle {
        width: Metrics.bubble-button-size;
        height: Metrics.bubble-button-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: touch.pressed && root.enabled
            ? Palette.foreground.with-alpha(0.16)
            : Palette.foreground.with-alpha(0.08);
        animate background {
            duration: 120ms;
            easing: ease-out;
        }

        Icon {
            source: root.icon;
            color: root.enabled ? root.tint : Colors.muted.with-alpha(0.35);
            width: Metrics.icon-md;
            height: Metrics.icon-md;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            transform-rotation: root.spin-angle;
            animate color {
                duration: 120ms;
                easing: ease-out;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Pill-shaped bubble button with text (e.g. Vault switcher, actions)
export component BubbleChip inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <color> tint: Palette.foreground;
    callback clicked();

    preferred-height: Metrics.touch;

    chip := Rectangle {
        height: Metrics.bubble-chip-height;
        y: (parent.height - self.height) / 2;
        border-radius: self.height / 2;
        background: touch.pressed && root.enabled
            ? Palette.foreground.with-alpha(0.16)
            : Palette.foreground.with-alpha(0.08);
        animate background {
            duration: 120ms;
            easing: ease-out;
        }

        HorizontalLayout {
            padding-left: Metrics.spacing-md;
            padding-right: Metrics.spacing-md;
            spacing: Metrics.spacing-xs + 2px * Metrics.ui-scale;
            alignment: center;

            if root.icon.width > 0: Icon {
                source: root.icon;
                color: root.enabled ? root.tint : Colors.muted.with-alpha(0.35);
                width: Metrics.icon-sm;
                height: Metrics.icon-sm;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: root.text;
                font-size: Metrics.font-md;
                font-weight: 600;
                color: root.enabled ? root.tint : Colors.muted.with-alpha(0.35);
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A small text-only pill button with a caller-chosen color (the editor's
// conflict bar needs "Keep Mine" in warning-orange next to "Next" in a
// neutral tone, which BubbleChip's fixed neutral background can't do).
export component PillButton inherits Rectangle {
    in property <string> text;
    in property <color> fill: Palette.foreground.with-alpha(0.08);
    in property <color> pressed-fill: Palette.foreground.with-alpha(0.18);
    in property <color> text-color: Palette.foreground;
    in property <bool> bold: false;
    callback clicked();

    height: 28px * Metrics.ui-scale;
    width: label.preferred-width + 16px * Metrics.ui-scale;
    border-radius: self.height / 2;
    background: touch.pressed ? root.pressed-fill : root.fill;

    label := HorizontalLayout {
        padding-left: 8px * Metrics.ui-scale;
        padding-right: 8px * Metrics.ui-scale;
        Text {
            text: root.text;
            font-size: Metrics.font-sm;
            font-weight: root.bold ? 700 : 600;
            color: root.text-color;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Capsule-grouped undo/redo bubble
export component UndoRedoBubble inherits Rectangle {
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    callback undo();
    callback redo();

    width: Metrics.bubble-button-size * 2 + 2px * Metrics.ui-scale;
    height: 100%;
    min-height: Metrics.touch;

    capsule := Rectangle {
        width: Metrics.bubble-button-size * 2 + 2px * Metrics.ui-scale;
        height: Metrics.bubble-button-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.height / 2;
        background: Palette.foreground.with-alpha(0.08);

        HorizontalLayout {
            padding: 0px;
            spacing: 0px;

            undo-box := Rectangle {
                width: (parent.width - 1px) / 2;
                height: Metrics.bubble-button-size;
                border-top-left-radius: self.height / 2;
                border-bottom-left-radius: self.height / 2;
                background: undo-touch.pressed && root.can-undo ? Palette.foreground.with-alpha(0.14) : transparent;

                Icon {
                    source: TablerIcons.arrow-back-up;
                    color: root.can-undo ? Palette.foreground : Colors.muted.with-alpha(0.3);
                    width: Metrics.icon-md;
                    height: Metrics.icon-md;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                undo-touch := TouchArea {
                    enabled: root.can-undo;
                    clicked => { root.undo(); }
                }
            }

            // Divider line between undo and redo
            Rectangle {
                width: 1px;
                height: Metrics.icon-md;
                y: (parent.height - self.height) / 2;
                background: Colors.separator;
            }

            redo-box := Rectangle {
                width: (parent.width - 1px) / 2;
                height: Metrics.bubble-button-size;
                border-top-right-radius: self.height / 2;
                border-bottom-right-radius: self.height / 2;
                background: redo-touch.pressed && root.can-redo ? Palette.foreground.with-alpha(0.14) : transparent;

                Icon {
                    source: TablerIcons.arrow-forward-up;
                    color: root.can-redo ? Palette.foreground : Colors.muted.with-alpha(0.3);
                    width: Metrics.icon-md;
                    height: Metrics.icon-md;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                redo-touch := TouchArea {
                    enabled: root.can-redo;
                    clicked => { root.redo(); }
                }
            }
        }
    }
}

// A tappable text row for an action sheet or menu -- not a list row (no
// separator, no selection highlight of its own).
export component ActionRow inherits Rectangle {
    in property <string> text;
    in property <color> tint: Palette.foreground;
    callback clicked();

    height: Metrics.touch;
    border-radius: Metrics.radius-sm + 2px * Metrics.ui-scale;
    background: touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent;
    animate background {
        duration: 150ms;
        easing: ease-out;
    }

    Text {
        x: Metrics.gutter;
        text: root.text;
        color: root.tint;
        font-size: Metrics.font-body + 1px * Metrics.ui-scale;
        vertical-alignment: center;
        height: 100%;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A row of equal-width pill segments, exactly one selected at a time
// (Settings' Theme/Font Size/UI Scale pickers all share this shape).
// A controlled component, like a radio group: `selected` is owned by the
// caller (an index for Theme/Font Size, a range-derived index for UI
// Scale) and only ever read here -- clicking a segment doesn't set
// `selected` itself, it reports the click via `changed` and waits for
// the caller to feed the new value back in, so callers whose index
// isn't a simple stored int (UI Scale's is derived from a continuous
// `Metrics.ui-scale`) work the same way as ones where it is.
export component SegmentedControl inherits HorizontalLayout {
    in property <[string]> options;
    in property <int> selected: 0;
    callback changed(int);

    spacing: Metrics.spacing-sm;

    for opt[i] in root.options: Rectangle {
        horizontal-stretch: 1;
        height: Metrics.bubble-chip-height;
        border-radius: self.height / 2;
        background: i == root.selected ? Palette.accent-background : Palette.foreground.with-alpha(0.08);

        Text {
            text: opt;
            font-size: Metrics.font-sub;
            font-weight: i == root.selected ? 600 : 400;
            color: i == root.selected ? Palette.accent-foreground : Palette.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => {
                root.changed(i);
            }
        }
    }
}

export component Fab inherits Rectangle {
    in property <bool> enabled: true;
    callback clicked();

    width: Metrics.fab;
    height: Metrics.fab;
    border-radius: self.width / 2;
    background: Palette.accent-background;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #00000055;

    Icon {
        source: TablerIcons.plus;
        color: Palette.accent-foreground;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Clean mobile scroll view with a modern floating translucent pill scroll indicator,
// replacing the wireframe outline scrollbar in standard widgets.
export component AppScrollView inherits Rectangle {
    in property <bool> enabled: true;
    out property <length> visible-width <=> flickable.width;
    out property <length> visible-height <=> flickable.height;
    in-out property <length> content-width <=> flickable.content-width;
    in-out property <length> content-height <=> flickable.content-height;
    in-out property <length> content-x <=> flickable.content-x;
    in-out property <length> content-y <=> flickable.content-y;
    callback scrolled <=> flickable.flicked;

    clip: true;

    flickable := Flickable {
        width: 100%;
        height: 100%;
        content-width: flickable.width;
        interactive: root.enabled;
        mouse-drag-pan-enabled: true;

        @children
    }

    // Modern mobile floating pill scrollbar (solid semi-transparent, no wireframe box)
    property <bool> show-scrollbar: flickable.content-height > flickable.height + 2px;
    property <length> track-height: flickable.height;
    property <length> thumb-height: max(28px, flickable.height * min(1.0, flickable.height / max(1px, flickable.content-height)));
    property <length> max-scroll: max(1px, flickable.content-height - flickable.height);
    property <length> thumb-y: (-flickable.content-y / root.max-scroll) * (root.track-height - root.thumb-height);

    if root.show-scrollbar: Rectangle {
        x: parent.width - 5px;
        y: min(max(2px, root.thumb-y), root.track-height - root.thumb-height - 2px);
        width: 3px;
        height: root.thumb-height;
        border-radius: 1.5px;
        background: Palette.foreground.with-alpha(0.28);
    }
}

// Thin 1px separator line between rows inside a Card or section.
export component Divider inherits Rectangle {
    height: 1px;
    background: Colors.separator;
}

// Elevated rounded-rect "grouped card" wrapper -- the home/settings shell
// that most sectioned content (a vault summary, a settings list, a
// details card) sits inside. Content is entirely up to the caller via
// @children; this only owns the shared chrome, so every call site stays
// on the same `Metrics`-scaled radius/padding instead of hand-rolled
// pixel literals drifting out of sync with `ui-scale`.
export component Card inherits Rectangle {
    in property <length> radius: Metrics.radius-md;
    in property <length> content-padding: Metrics.spacing-lg;
    in property <length> content-spacing: Metrics.spacing-md;

    border-radius: root.radius;
    background: Colors.surface-elevated;

    VerticalLayout {
        padding: root.content-padding;
        spacing: root.content-spacing;
        @children
    }
}

// A titled group: a small muted caption header (optionally with one
// trailing icon action, e.g. Home's "Sync Status" -> history button)
// above whatever body content the caller supplies via @children --
// typically a `Card`, but not required (a warning banner isn't one).
// Slint components only get a single @children slot, so the trailing
// action is its own icon/callback pair rather than a second slot.
export component Section inherits VerticalLayout {
    in property <string> title;
    in property <image> action-icon;
    in property <color> title-color: Colors.muted;
    callback action();

    spacing: Metrics.spacing-sm;

    if root.title != "": HorizontalLayout {
        spacing: Metrics.spacing-sm;

        Text {
            horizontal-stretch: 1;
            text: root.title;
            font-size: Metrics.font-caption;
            font-weight: 700;
            vertical-alignment: center;
            color: root.title-color;
            letter-spacing: 0.5px;
        }

        // The Rectangle only takes up the icon's own size, not a full
        // touch target -- sized to Metrics.touch like every other tap
        // target here, it would make *this* row the tallest thing in
        // the HorizontalLayout (the title Text is much shorter), which
        // balloons the header's own height and reads as an oversized
        // gap before whatever content follows. The TouchArea below still
        // gets the full touch-sized hit area by overflowing this
        // Rectangle vertically instead of being sized by it.
        if root.action-icon.width > 0: VerticalLayout {
            alignment: center;

            Rectangle {
                width: Metrics.touch;
                height: Metrics.icon-sm;

                Icon {
                    source: root.action-icon;
                    width: Metrics.icon-sm;
                    height: Metrics.icon-sm;
                    color: Colors.muted;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                TouchArea {
                    x: 0px;
                    y: (parent.height - Metrics.touch) / 2;
                    width: Metrics.touch;
                    height: Metrics.touch;
                    clicked => { root.action(); }
                }
            }
        }
    }

    @children
}

// Square icon-over-label tile for a grid of actions/sections/entries
// (Home's Quick Actions, the Library hub's section picker, a Directory
// grid tile). `tint` is the caller's base color for the enabled/
// non-highlighted state (e.g. an accent color for a primary action);
// `enabled`/`highlighted` override it the same way across every caller
// instead of each screen re-deriving its own muted/accent logic.
// `label-text: ""` drops the label row entirely, for a bare icon-swatch
// grid that has nothing to name.
export component IconTile inherits Rectangle {
    in property <image> icon;
    in property <string> label-text;
    in property <color> tint: Palette.foreground;
    in property <bool> enabled: true;
    in property <bool> highlighted: false;
    in property <bool> show-dot: false;
    in property <length> tile-height: 76px * Metrics.ui-scale;
    in property <bool> long-press-enabled: false;
    callback clicked();
    callback long-pressed();

    property <color> effective-tint: !root.enabled
        ? Colors.muted
        : (root.highlighted ? Palette.accent-background : root.tint);

    horizontal-stretch: 1;
    // Zeroing both min/preferred-width makes equal-column grids split
    // purely by stretch instead of by each tile's own label width (see
    // the `LibrarySectionTile` comment this was ported from).
    min-width: 0px;
    preferred-width: 0px;
    height: root.tile-height;
    border-radius: Metrics.radius-md;
    opacity: root.enabled ? 1.0 : 0.5;
    background: touch.pressed && root.enabled
        ? Palette.foreground.with-alpha(0.12)
        : (root.highlighted ? Palette.accent-background.with-alpha(0.20) : Colors.surface-elevated);
    animate background {
        duration: 150ms;
        easing: ease-out;
    }

    VerticalLayout {
        alignment: center;
        spacing: Metrics.spacing-xs;

        HorizontalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: Metrics.icon-lg;
                height: Metrics.icon-lg;
                color: root.effective-tint;
            }
        }

        // Icon-only callers (a bare swatch grid, no name underneath)
        // pass an empty `label-text` -- skip the row entirely rather
        // than reserving space for an empty `Text`'s line height.
        if root.label-text != "": HorizontalLayout {
            alignment: center;
            spacing: Metrics.spacing-xs;

            Text {
                text: root.label-text;
                font-size: Metrics.font-sm;
                font-weight: 600;
                color: root.effective-tint;
                horizontal-alignment: center;
                overflow: elide;
            }

            if root.show-dot: Rectangle {
                width: Metrics.spacing-sm;
                height: Metrics.spacing-sm;
                border-radius: Metrics.spacing-sm / 2;
                background: Colors.warning;
            }
        }
    }

    property <bool> long-press-fired: false;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.long-press-fired) {
                root.long-press-fired = false;
            } else {
                root.clicked();
            }
        }
    }

    Timer {
        interval: 400ms;
        running: touch.pressed && root.long-press-enabled && !root.long-press-fired;
        triggered => {
            root.long-press-fired = true;
            root.long-pressed();
        }
    }
}

// A tappable row inside a scrollable list -- an inset rounded highlight
// so it reads as "selectable" without the row owning its own card chrome
// (a `Directory` browser's folder/note rows, or any future flat list of
// icon+label entries). `leading-icon` is optional (omit it, or pass a
// zero-size `image`, for a title-only row); `show-chevron` marks a row
// that drills into something else rather than acting directly (a folder,
// a settings category) the same way `show-dot` marks one that needs
// attention (a sync conflict).
export component SelectableRow inherits Rectangle {
    in property <image> leading-icon;
    in property <string> label-text;
    in property <bool> bold: false;
    in property <bool> highlighted: false;
    in property <bool> show-dot: false;
    in property <bool> show-chevron: false;
    in property <bool> long-press-enabled: false;
    callback clicked();
    callback long-pressed();

    height: Metrics.row-height;

    Rectangle {
        x: Metrics.spacing-sm;
        y: Metrics.spacing-xs / 2;
        width: parent.width - Metrics.spacing-lg;
        height: parent.height - Metrics.spacing-xs;
        border-radius: Metrics.radius-lg;
        background: root.highlighted
            ? Palette.accent-background.with-alpha(0.20)
            : (touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent);
        animate background {
            duration: 150ms;
            easing: ease-out;
        }

        HorizontalLayout {
            padding-left: Metrics.spacing-lg;
            padding-right: Metrics.spacing-lg;
            spacing: Metrics.spacing-sm;

            if root.leading-icon.width > 0: VerticalLayout {
                alignment: center;
                Icon {
                    source: root.leading-icon;
                    width: Metrics.icon-sm;
                    height: Metrics.icon-sm;
                    color: Colors.muted;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;

                Text {
                    text: root.label-text;
                    font-size: Metrics.font-body;
                    font-weight: (root.bold || root.highlighted) ? 600 : 400;
                    color: root.highlighted ? Palette.accent-background : Palette.foreground;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            if root.show-dot: Rectangle {
                width: Metrics.spacing-sm;
                height: Metrics.spacing-sm;
                y: (parent.height - self.height) / 2;
                border-radius: Metrics.spacing-sm / 2;
                background: Colors.warning;
            }

            if root.show-chevron: VerticalLayout {
                alignment: center;
                Icon {
                    source: TablerIcons.chevron-right;
                    width: Metrics.icon-sm;
                    height: Metrics.icon-sm;
                    color: Colors.muted;
                }
            }
        }
    }

    property <bool> long-press-fired: false;

    touch := TouchArea {
        clicked => {
            if (root.long-press-fired) {
                root.long-press-fired = false;
            } else {
                root.clicked();
            }
        }
    }

    Timer {
        interval: 400ms;
        running: touch.pressed && root.long-press-enabled && !root.long-press-fired;
        triggered => {
            root.long-press-fired = true;
            root.long-pressed();
        }
    }
}

import { Palette, Button } from "std-widgets.slint";
import { Colors } from "@origami-mobile/tokens.slint";
import { ModalShell, DragHandle } from "@origami-mobile/impl/modal_shell.slint";

// Modern responsive confirmation dialog / bottom sheet.
export component ConfirmDialog inherits Rectangle {
    in property <bool> open: false;
    in property <bool> narrow: true;
    in property <string> title;
    in property <string> body;
    in property <string> confirm-text: @tr("Confirm");
    in property <length> inset-bottom: 0px;
    callback confirm();
    callback cancel();

    width: 100%;
    height: 100%;

    ModalShell {
        open: root.open;
        narrow: root.narrow;
        inset-bottom: root.inset-bottom;
        card-max-width: 420px;
        cancel => { root.cancel(); }

        if root.narrow: DragHandle { }

        Text {
            text: root.title;
            font-size: 20px;
            font-weight: 600;
            color: Palette.foreground;
        }

        if root.body != "": Text {
            text: root.body;
            font-size: 14px;
            color: Colors.muted;
            wrap: word-wrap;
        }

        HorizontalLayout {
            height: 40px;
            alignment: end;
            spacing: 10px;

            Button {
                text: @tr("Cancel");
                clicked => { root.cancel(); }
            }

            Button {
                text: root.confirm-text;
                primary: true;
                clicked => { root.confirm(); }
            }
        }
    }
}

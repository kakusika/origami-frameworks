// Shared design-token global. Imported by consuming apps via slint-build's
// library-path mechanism (`import { Tokens } from "@origami/tokens.slint";`),
// NOT copied per app.
//
// Every property is `in-out` (not `out`) so a consuming app's own Rust glue
// can push resolved values in at runtime (`origami_theme::resolve`, from the
// `ThemeSettings` the app passes in). The literal defaults below are just a
// sane compile-time fallback so a UI still renders sensibly before that push
// happens -- they mirror `origami-theme`'s `ColorTokens`/`ShapeTokens`/
// `SpacingTokens` 1:1; keep both in sync by hand if either changes.
export global Tokens {
    // -- Colors (Origami Aubergine & Crimson Palette; the dark preset resolved) --
    // Every color is opaque. The three grounds come first; what is drawn on a
    // ground (borders, hover, selection, quiet text, accent washes) is
    // declared once per ground -- no suffix for `background`, `-on-surface`
    // for `surface`, `-on-raised` for `surface-raised` -- already blended
    // against it, so a view picks the set for the ground it sits on and
    // never tints a color at the point of use.
    in-out property <color> background: #150c1d;
    in-out property <color> surface: #21142d;
    in-out property <color> surface-raised: #34204a;
    in-out property <color> accent: #d12a55;
    in-out property <color> text-on-accent: #f1f3f9;
    in-out property <color> text-on-destructive: #f1f3f9;
    in-out property <color> text-primary: #f4eaf8;
    in-out property <color> destructive: #da4453;
    in-out property <color> accent-hover: #d74469;
    in-out property <color> accent-pressed: #a72244;
    in-out property <color> destructive-hover: #de5a68;
    in-out property <color> destructive-pressed: #ae3642;
    in-out property <color> success: #10b981;

    in-out property <color> border: #6e6575;
    in-out property <color> border-hover: #9b91a0;
    in-out property <color> divider: #857b8b;
    in-out property <color> hover: #311125;
    in-out property <color> pressed: #731b39;
    in-out property <color> selected: #44142b;
    in-out property <color> text-secondary: #a69cab;
    in-out property <color> text-disabled: #797080;
    in-out property <color> accent-soft: #571731;
    in-out property <color> accent-strong: #861e3f;
    in-out property <color> destructive-soft: #3c1728;
    in-out property <color> destructive-border: #782838;
    in-out property <color> success-soft: #142f31;
    in-out property <color> success-border: #13634f;

    in-out property <color> border-on-surface: #756a7e;
    in-out property <color> border-hover-on-surface: #a094a7;
    in-out property <color> divider-on-surface: #8b7f93;
    in-out property <color> hover-on-surface: #3b1733;
    in-out property <color> pressed-on-surface: #791f41;
    in-out property <color> selected-on-surface: #4d1a37;
    in-out property <color> text-secondary-on-surface: #aa9fb1;
    in-out property <color> text-disabled-on-surface: #807488;
    in-out property <color> accent-soft-on-surface: #5f1c3b;
    in-out property <color> accent-strong-on-surface: #8b2145;
    in-out property <color> destructive-soft-on-surface: #461e35;
    in-out property <color> destructive-border-on-surface: #7e2c40;
    in-out property <color> success-soft-on-surface: #1e353e;
    in-out property <color> success-border-on-surface: #196757;

    in-out property <color> border-on-raised: #817190;
    in-out property <color> border-hover-on-raised: #a799b2;
    in-out property <color> divider-on-raised: #9485a1;
    in-out property <color> hover-on-raised: #4c224c;
    in-out property <color> pressed-on-raised: #832550;
    in-out property <color> selected-on-raised: #5b234d;
    in-out property <color> text-secondary-on-raised: #b1a3bb;
    in-out property <color> text-disabled-on-raised: #8e7f9c;
    in-out property <color> accent-soft-on-raised: #6b244e;
    in-out property <color> accent-strong-on-raised: #922651;
    in-out property <color> destructive-soft-on-raised: #55274c;
    in-out property <color> destructive-border-on-raised: #87324f;
    in-out property <color> success-soft-on-raised: #2d3f55;
    in-out property <color> success-border-on-raised: #226d66;

    // -- Spacing --
    in-out property <length> spacing-small: 4px;
    in-out property <length> spacing-medium: 8px;
    in-out property <length> spacing-large: 16px;

    // -- Shape --
    in-out property <length> corner-radius: 4px;
    in-out property <length> border-width: 1px;

    // -- Typography (not yet resolved from settings -- no persisted font
    // setting this crate reads today, kept as fixed literals) --
    in-out property <length> font-size-small: 11px;
    in-out property <length> font-size-normal: 13px;
    in-out property <length> font-size-large: 15px;

    // -- Animation (ms) -- 0 means "apply immediately, no animation" (see
    // `AnimationTokens` doc comment), consuming .slint files should treat
    // 0 as a valid, meaningful duration, not a placeholder.
    in-out property <int> anim-very-short: 60;
    in-out property <int> anim-short: 180;
    in-out property <int> anim-long: 360;
    in-out property <int> anim-very-long: 600;
}

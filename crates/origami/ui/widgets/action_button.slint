import { Tokens } from "@origami/tokens.slint";
import { Icon } from "@origami-icons/icons.slint";

// Slint port of origami/qml/widgets/buttons/ActionButton.qml.
// Extended action button with icon, title label, keyboard shortcut hint, and badge support.
export component ActionButton inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: root.icon.width > 0;
    in property <string> text: "";
    in property <string> shortcut-text: "";
    in property <string> badge-text: "";
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> primary: false;
    in property <bool> destructive: false;
    callback clicked();

    height: 32px;
    width: layout.preferred-width + Tokens.spacing-medium * 2;
    border-radius: Tokens.corner-radius;
    border-width: Tokens.border-width;
    border-color: !root.enabled ? Tokens.border-on-surface :
        root.destructive ? (touch.has-hover ? Tokens.destructive-hover : Tokens.destructive) :
        root.primary ? (touch.has-hover ? Tokens.accent-hover : Tokens.accent) :
        root.active ? Tokens.accent :
        (touch.has-hover ? Tokens.accent : Tokens.border-on-surface);

    background: !root.enabled ? Tokens.surface :
        root.destructive ? (touch.has-hover ? Tokens.destructive-hover : Tokens.destructive) :
        root.primary ? (touch.has-hover ? Tokens.accent-hover : Tokens.accent) :
        root.active ? Tokens.selected-on-surface :
        (touch.has-hover ? Tokens.hover-on-surface : Tokens.surface);

    animate background {
        duration: Tokens.anim-very-short * 1ms;
        easing: ease-out;
    }
    animate border-color {
        duration: Tokens.anim-very-short * 1ms;
        easing: ease-out;
    }

    layout := HorizontalLayout {
        padding-left: Tokens.spacing-medium;
        padding-right: Tokens.spacing-medium;
        spacing: Tokens.spacing-small;
        alignment: center;

        if root.has-icon: Icon {
            source: root.icon;
            color: !root.enabled ? Tokens.text-disabled-on-surface : (root.destructive ? Tokens.text-on-destructive : root.primary ? Tokens.text-on-accent : (root.active ? Tokens.accent : Tokens.text-primary));
            width: 16px;
            height: 16px;
            vertical-alignment: center;
        }

        if root.text != "": Text {
            text: root.text;
            color: !root.enabled ? Tokens.text-disabled-on-surface : (root.destructive ? Tokens.text-on-destructive : root.primary ? Tokens.text-on-accent : (root.active ? Tokens.accent : Tokens.text-primary));
            font-size: Tokens.font-size-normal;
            font-weight: (root.primary || root.active) ? 600 : 400;
            vertical-alignment: center;
        }

        if root.shortcut-text != "": Text {
            text: root.shortcut-text;
            color: !root.enabled ? Tokens.text-disabled-on-surface : (root.primary || root.destructive ? Tokens.text-on-accent : Tokens.text-secondary-on-surface);
            font-size: Tokens.font-size-small;
            vertical-alignment: center;
        }

        if root.badge-text != "": Rectangle {
            background: Tokens.accent;
            border-radius: 6px;
            height: 16px;
            width: max(16px, badge-label.preferred-width + 6px);

            badge-label := Text {
                text: root.badge-text;
                color: Tokens.text-on-accent;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

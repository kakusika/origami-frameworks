import { Tokens } from "@origami/tokens.slint";
import { Icon, TablerIcons } from "@origami-icons/icons.slint";

// Rich toggle button with title, subtitle/detail, and selection checkmark.
export component DetailToggleButton inherits Rectangle {
    in property <string> title: "";
    in property <string> detail: "";
    in property <image> icon;
    in property <bool> has-icon: root.icon.width > 0;
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    height: max(48px, layout.preferred-height + Tokens.spacing-small * 2);
    min-width: 180px;
    border-radius: Tokens.corner-radius + 2px;
    border-width: root.checked ? 2px : Tokens.border-width;
    border-color: !root.enabled ? Tokens.border-on-surface :
        root.checked ? Tokens.accent :
        (touch.has-hover ? Tokens.accent-strong-on-surface : Tokens.border-on-surface);
    background: !root.enabled ? Tokens.surface :
        root.checked ? Tokens.selected-on-surface :
        (touch.has-hover ? Tokens.hover-on-surface : Tokens.surface);

    animate background {
        duration: Tokens.anim-very-short * 1ms;
        easing: ease-out;
    }
    animate border-color {
        duration: Tokens.anim-very-short * 1ms;
        easing: ease-out;
    }

    layout := HorizontalLayout {
        padding: Tokens.spacing-medium;
        spacing: Tokens.spacing-medium;
        alignment: center;

        if root.has-icon: Icon {
            source: root.icon;
            color: !root.enabled ? Tokens.text-disabled-on-surface : (root.checked ? Tokens.accent : Tokens.text-secondary-on-surface);
            width: 22px;
            height: 22px;
            vertical-alignment: center;
        }

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: root.title;
                color: !root.enabled ? Tokens.text-disabled-on-surface : Tokens.text-primary;
                font-size: Tokens.font-size-normal;
                font-weight: root.checked ? 600 : 500;
                overflow: elide;
            }

            if root.detail != "": Text {
                text: root.detail;
                color: Tokens.text-secondary-on-surface;
                font-size: Tokens.font-size-small;
                overflow: elide;
            }
        }

        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 8px;
            border-width: 1.5px;
            border-color: root.checked ? Tokens.accent : Tokens.border-on-surface;
            background: root.checked ? Tokens.accent : transparent;

            if root.checked: Icon {
                source: TablerIcons.check;
                color: Tokens.text-on-accent;
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

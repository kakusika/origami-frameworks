import { Tokens } from "@origami/tokens.slint";

// A thin divider line -- one shared component instead of each caller hand-rolling its own `Rectangle` (see
// `.agents/tasks/widget-parity-beyond-panes.md`), matching the original QML framework's shared
// `Separator.qml` (`origami/qml/widgets/controls/Separator.qml`). A plain element's width/height default to
// filling its container when left unset (rather than to 0), so leaving the cross-axis dimension unset here
// is what makes that happen -- Slint has no way to express "unset" conditionally on a single component, so
// the vertical variant is its own component (`VerticalSeparator`, in vertical_separator.slint) instead of
// one with an orientation property.
export component Separator inherits Rectangle {
    height: Tokens.border-width;
    background: Tokens.divider;
}

import { Tokens } from "@origami/tokens.slint";

// A thin vertical divider line, for the heavier look used between structural regions (toolbars, side
// rails) rather than inside a menu/list -- unlike the QML version's alpha-based color, this is opaque.
export component VerticalSeparator inherits Rectangle {
    width: Tokens.border-width;
    background: Tokens.border;
}

import { Palette } from "std-widgets.slint";
import { Colors } from "@origiri-mobile/tokens.slint";

// The narrow-screen "grabber" pill shown at the top of a bottom sheet.
export component DragHandle inherits HorizontalLayout {
    alignment: center;
    Rectangle {
        width: 36px;
        height: 4px;
        border-radius: 2px;
        background: Palette.foreground.with-alpha(0.2);
    }
}

// The scrim + animated card shared by every bottom-sheet/dialog hybrid --
// on narrow/mobile screens it slides up from the bottom, on wide/desktop
// screens it's a centered modal with a backdrop scrim. Content (drag
// handle, title, body, buttons) is entirely up to the caller via
// @children -- this only owns the shell and its animation.
export component ModalShell inherits Rectangle {
    in property <bool> open: false;
    in property <bool> narrow: true;
    in property <length> inset-bottom: 0px;
    in property <length> card-max-width: 440px;
    in property <length> content-padding-left: 20px;
    in property <length> content-padding-right: 20px;
    in property <length> content-padding-top: 16px;
    in property <length> content-padding-bottom: 20px;
    in property <length> content-spacing: 16px;
    callback cancel();

    width: 100%;
    height: 100%;
    visible: root.open || self.opacity > 0.01;
    opacity: root.open ? 1.0 : 0.0;
    animate opacity {
        duration: 140ms;
        easing: ease-out;
    }

    // Scrim / Backdrop overlay
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.45);

        TouchArea {
            enabled: root.open;
            clicked => { root.cancel(); }
        }
    }

    // Modal Card / Bottom Sheet
    card := Rectangle {
        width: root.narrow ? (parent.width - 24px) : min(root.card-max-width, parent.width - 32px);
        height: content-layout.preferred-height;
        x: (parent.width - self.width) / 2;
        y: root.narrow
            ? (root.open ? parent.height - self.height - 12px - root.inset-bottom : parent.height)
            : ((parent.height - self.height) / 2 + (root.open ? 0px : 24px));
        animate y {
            duration: 160ms;
            easing: ease-out;
        }

        background: Colors.surface-elevated;
        border-radius: 20px;
        drop-shadow-blur: 24px;
        drop-shadow-color: Palette.color-scheme == ColorScheme.dark ? #00000088 : #00000044;

        content-layout := VerticalLayout {
            padding-left: root.content-padding-left;
            padding-right: root.content-padding-right;
            padding-top: root.content-padding-top;
            padding-bottom: root.content-padding-bottom;
            spacing: root.content-spacing;

            @children
        }
    }
}

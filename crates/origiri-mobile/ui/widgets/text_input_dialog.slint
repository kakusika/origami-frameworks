import { Palette, LineEdit, Button } from "std-widgets.slint";
import { Metrics } from "@origiri-mobile/tokens.slint";
import { ModalShell, DragHandle } from "@origiri-mobile/impl/modal_shell.slint";

// Modern responsive text input dialog / bottom sheet.
export component TextInputDialog inherits Rectangle {
    in property <bool> open: false;
    in property <bool> narrow: true;
    in property <string> title;
    in-out property <string> text-draft;
    in property <length> inset-bottom: 0px;
    callback save(string);
    callback cancel();

    width: 100%;
    height: 100%;

    ModalShell {
        open: root.open;
        narrow: root.narrow;
        inset-bottom: root.inset-bottom;
        card-max-width: 440px;
        cancel => { root.cancel(); }

        if root.narrow: DragHandle { }

        Text {
            text: root.title;
            font-size: 20px;
            font-weight: 600;
            color: Palette.foreground;
        }

        text-field := LineEdit {
            height: Metrics.touch;
            text <=> root.text-draft;
            accepted => {
                if (root.text-draft != "") {
                    root.save(root.text-draft);
                }
            }
        }

        HorizontalLayout {
            height: 40px;
            alignment: end;
            spacing: 10px;

            Button {
                text: @tr("Cancel");
                clicked => { root.cancel(); }
            }

            Button {
                text: @tr("Save");
                primary: true;
                enabled: root.text-draft != "";
                clicked => { root.save(root.text-draft); }
            }
        }
    }
}

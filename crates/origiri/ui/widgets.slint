// Public widget barrel: every component this library exports for consumers to use,
// re-exported from its own file under widgets/. Mirrors Slint's own
// std-widgets.slint pattern -- consumers can import everything from this one
// path, or import a single component directly from widgets/<name>.slint.
//
// Internal cross-file helpers (exported only because Slint requires it to
// share them across files, not meant to be picked by consumers) live under
// impl/ and are deliberately NOT re-exported here.

export { ActionButton } from "widgets/action_button.slint";

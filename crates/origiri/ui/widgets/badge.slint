import { Tokens } from "@origiri/tokens.slint";

export component Badge inherits Rectangle {
    in property <string> text;
    in property <string> variant: "accent";

    height: 20px;
    width: label.preferred-width + Tokens.spacing-medium * 1.5;
    border-radius: self.height / 2;
    background: root.variant == "destructive" ? Tokens.destructive-soft-on-raised :
        root.variant == "neutral" ? Tokens.surface-raised :
        root.variant == "success" ? Tokens.success-soft-on-raised :
        Tokens.accent-soft-on-raised;
    border-width: 1px;
    border-color: root.variant == "destructive" ? Tokens.destructive-border-on-raised :
        root.variant == "neutral" ? Tokens.border-on-raised :
        root.variant == "success" ? Tokens.success-border-on-raised :
        Tokens.accent-strong-on-raised;

    label := Text {
        text: root.text;
        font-size: Tokens.font-size-small;
        font-weight: 600;
        color: root.variant == "destructive" ? Tokens.destructive :
            root.variant == "neutral" ? Tokens.text-secondary-on-raised :
            root.variant == "success" ? #10b981 :
            Tokens.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

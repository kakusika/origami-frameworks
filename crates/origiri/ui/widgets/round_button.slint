import { Tokens } from "@origiri/tokens.slint";
import { Icon } from "@origiri-icons/icons.slint";

// Slint port of origiri/qml/widgets/buttons/RoundButton.qml.
export component RoundButton inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: root.icon.width > 0;
    in property <string> text: "";
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> primary: false;
    in property <length> size: 36px;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: self.height / 2;
    border-width: Tokens.border-width;
    border-color: !root.enabled ? Tokens.border-on-surface :
        root.primary ? (touch.has-hover ? Tokens.accent-hover : Tokens.accent) :
        root.active ? Tokens.accent :
        (touch.has-hover ? Tokens.accent : Tokens.border-on-surface);
    background: !root.enabled ? Tokens.surface :
        root.primary ? (touch.has-hover ? Tokens.accent-hover : Tokens.accent) :
        root.active ? Tokens.selected-on-surface :
        (touch.has-hover ? Tokens.hover-on-surface : Tokens.surface);

    animate background {
        duration: Tokens.anim-very-short * 1ms;
        easing: ease-out;
    }
    animate border-color {
        duration: Tokens.anim-very-short * 1ms;
        easing: ease-out;
    }

    if root.has-icon: Icon {
        source: root.icon;
        color: !root.enabled ? Tokens.text-disabled-on-surface : (root.primary ? Tokens.text-on-accent : (root.active ? Tokens.accent : Tokens.text-primary));
        width: root.size * 0.45;
        height: root.size * 0.45;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    if !root.has-icon && root.text != "": Text {
        text: root.text;
        color: !root.enabled ? Tokens.text-disabled-on-surface : (root.primary ? Tokens.text-on-accent : (root.active ? Tokens.accent : Tokens.text-primary));
        font-size: Tokens.font-size-normal;
        font-weight: (root.primary || root.active) ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

import { Tokens } from "@origiri/tokens.slint";
import { Icon } from "@origiri-icons/icons.slint";

// Slint port of origiri/qml/widgets/buttons/ToggleButton.qml.
export component ToggleButton inherits Rectangle {
    in property <string> text: "";
    in property <image> icon;
    in property <bool> has-icon: root.icon.width > 0;
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    height: 32px;
    width: layout.preferred-width + Tokens.spacing-medium * 2;
    border-radius: Tokens.corner-radius;
    border-width: Tokens.border-width;
    border-color: !root.enabled ? Tokens.border-on-surface :
        root.checked ? Tokens.accent :
        (touch.has-hover ? Tokens.border-hover-on-surface : Tokens.border-on-surface);
    background: !root.enabled ? Tokens.surface :
        root.checked ? Tokens.selected-on-surface :
        (touch.has-hover ? Tokens.hover-on-surface : Tokens.surface);

    animate background {
        duration: Tokens.anim-very-short * 1ms;
        easing: ease-out;
    }
    animate border-color {
        duration: Tokens.anim-very-short * 1ms;
        easing: ease-out;
    }

    layout := HorizontalLayout {
        padding-left: Tokens.spacing-medium;
        padding-right: Tokens.spacing-medium;
        spacing: Tokens.spacing-small;
        alignment: center;

        if root.has-icon: Icon {
            source: root.icon;
            color: !root.enabled ? Tokens.text-disabled-on-surface : (root.checked ? Tokens.accent : Tokens.text-primary);
            width: 16px;
            height: 16px;
            vertical-alignment: center;
        }

        if root.text != "": Text {
            text: root.text;
            color: !root.enabled ? Tokens.text-disabled-on-surface : (root.checked ? Tokens.accent : Tokens.text-primary);
            font-size: Tokens.font-size-normal;
            font-weight: root.checked ? 600 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

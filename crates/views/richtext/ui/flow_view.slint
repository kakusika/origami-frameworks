// Generic renderer for lines of mixed text + embedded-element fragments,
// as produced by `origami-richtext-flow::layout::layout_block`.
//
// Ships as `.slint` source only -- the importing app compiles this file
// together with its own tree (see `src/lib.rs`'s doc comment for why).
// `RichTextFragment`/`RichTextLine` here are placeholders the app's own
// seam code (its `render.rs`-equivalent) must construct from
// `origami-richtext-flow`'s `Fragment`/`Line` on every change.
//
// A resolved line's fragments are positioned by Slint's own
// `HorizontalLayout`, not by any coordinate carried on `RichTextFragment`:
// `origami-richtext-flow::layout::Fragment`'s `x` is bookkeeping for the
// Rust-side line-breaking *decision* (which fragments end up on which
// line), not a pixel position this component needs to consume -- a line,
// once resolved, lays its fragments out left to right exactly like any
// other row of mixed `Text`/widget elements would.

export struct RichTextFragment {
    // Text fragments render `text`; element fragments instantiate `factory`.
    // Slint has no tagged-union property type, so this flag picks the arm
    // instead of e.g. an `enum` discriminant on the struct.
    is-element: bool,
    text: string,
    factory: component-factory,
    // `origami-richtext-flow::TextStyle`, pre-decoded by the caller's own
    // seam: Slint's expression language has no bitwise operators to
    // decode a packed `StyleId` here, so the unpacked booleans travel
    // instead. Unused when `is-element` is true.
    bold: bool,
    italic: bool,
    mark: bool,
    strikeout: bool,
}

export struct RichTextLine {
    fragments: [RichTextFragment],
}

export component FlowView {
    in property <[RichTextLine]> lines;
    // No default: the caller's text fragments must render at the same
    // size the caller measured them at (see `origami-richtext-flow`'s
    // `Measure` trait) -- a silent mismatched default would make wrap
    // decisions subtly wrong rather than obviously unset.
    in property <length> font-size;
    // Themeable: this crate has no theme tokens of its own to pull a
    // highlight color from, so a caller with real design tokens should
    // override this rather than live with the plain default.
    in property <brush> mark-background: #fff59d80;

    VerticalLayout {
        alignment: start;

        for line in root.lines: HorizontalLayout {
            alignment: start;

            for frag in line.fragments: Rectangle {
                background: !frag.is-element && frag.mark ? root.mark-background : transparent;

                if !frag.is-element: text-item := Text {
                    text: frag.text;
                    font-size: root.font-size;
                    font-weight: frag.bold ? 700 : 400;
                    font-italic: frag.italic;
                }

                if frag.is-element: ComponentContainer {
                    component-factory: frag.factory;
                }

                if !frag.is-element && frag.strikeout: Rectangle {
                    y: parent.height / 2;
                    width: text-item.preferred-width;
                    height: 1px;
                    background: text-item.color;
                }
            }
        }
    }
}

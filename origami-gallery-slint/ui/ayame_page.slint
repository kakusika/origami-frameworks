import { Tokens } from "@ayame/tokens.slint";
import { SectionLabel, AppButton, ToggleSwitch, DropdownButton, ColorSwatchRow, OptionSlider, CollapsibleSection, SidebarCategoryList, CheckBox, RadioButton, AppTextField, AppTextArea, ProgressBar, Badge, Divider, Card, ButtonGroup, ButtonGroupItem, ToolTip, TabBar, TabItem } from "@ayame/components.slint";
import { Icons } from "@ayame/icons.slint";

// Live showcase of every `ayame-slint` basic design system component grouped into collapsible sections.
export component AyamePage inherits Rectangle {
    property <string> status: "Interact with a widget below to see its callback fire here.";

    property <float> slider-value: 0.4;
    property <[color]> swatches: [#ef4444, #f59e0b, #10b981, #3b82f6, #8b5cf6];
    property <int> swatch-selected: 3;
    property <bool> demo-checkbox: true;
    property <int> demo-radio: 0;
    property <string> demo-input: "Ayame Slint UI";
    property <float> demo-progress: 0.68;
    property <int> demo-button-group: 0;
    property <int> demo-tab: 0;
    property <int> demo-sidebar-idx: 0;

    Flickable {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height - 34px;
        content-height: content.preferred-height + 24px;

        content := VerticalLayout {
            width: parent.width;
            padding: Tokens.spacing-large;
            spacing: Tokens.spacing-large;

            // Page Header Card
            Rectangle {
                background: Tokens.surface;
                border-radius: Tokens.corner-radius + 2px;
                border-width: Tokens.border-width;
                border-color: Tokens.border;

                VerticalLayout {
                    padding: Tokens.spacing-large;
                    spacing: Tokens.spacing-small;

                    Text {
                        text: "ayame-slint Foundation Components";
                        font-weight: 700;
                        font-size: Tokens.font-size-large + 2px;
                        color: Tokens.text-primary;
                    }
                    Text {
                        text: "Ayame design-system tokens, basic buttons, selection controls, text fields, badges, and progress bars.";
                        color: Tokens.text-secondary;
                        font-size: Tokens.font-size-normal;
                        wrap: word-wrap;
                    }
                }
            }

            // ==========================================
            // Category 1: Buttons, Toggles & Swatches
            // ==========================================
            CollapsibleSection {
                title: "Buttons, Toggles & Swatches";
                expanded: true;

                VerticalLayout {
                    spacing: Tokens.spacing-large;
                    padding-top: Tokens.spacing-small;

                    // AppButton
                    VerticalLayout {
                        spacing: Tokens.spacing-small;
                        Text { text: "AppButton (Button Variants)"; font-weight: 600; font-size: Tokens.font-size-small; color: Tokens.text-secondary; }

                        HorizontalLayout {
                            spacing: Tokens.spacing-medium;
                            alignment: start;
                            AppButton { text: "Default"; clicked => { root.status = "AppButton: Default clicked"; } }
                            AppButton { text: "Primary"; primary: true; clicked => { root.status = "AppButton: Primary clicked"; } }
                            AppButton { text: "Destructive"; destructive: true; clicked => { root.status = "AppButton: Destructive clicked"; } }
                            AppButton { text: "Disabled"; enabled: false; }
                        }
                    }

                    // ButtonGroup & ToolTip
                    VerticalLayout {
                        spacing: Tokens.spacing-small;
                        Text { text: "ButtonGroup (Segmented Selection)"; font-weight: 600; font-size: Tokens.font-size-small; color: Tokens.text-secondary; }

                        ButtonGroup {
                            items: [
                                { id: "left", text: "Left", icon: Icons.folder, has-icon: false },
                                { id: "center", text: "Center", icon: Icons.file, has-icon: false },
                                { id: "right", text: "Right", icon: Icons.maximize, has-icon: false },
                            ];
                            selected-index <=> root.demo-button-group;
                            selected(idx, id) => {
                                root.status = "ButtonGroup: selected " + id + " (index " + idx + ")";
                            }
                        }
                    }

                    // ToggleSwitch
                    VerticalLayout {
                        spacing: Tokens.spacing-small;
                        Text { text: "ToggleSwitch"; font-weight: 600; font-size: Tokens.font-size-small; color: Tokens.text-secondary; }

                        ToggleSwitch {
                            text: "Enable high contrast mode";
                            toggled(v) => { root.status = "ToggleSwitch: toggled(" + (v ? "true" : "false") + ")"; }
                        }
                    }

                    // ColorSwatchRow
                    VerticalLayout {
                        spacing: Tokens.spacing-small;
                        Text { text: "ColorSwatchRow"; font-weight: 600; font-size: Tokens.font-size-small; color: Tokens.text-secondary; }

                        ColorSwatchRow {
                            swatches: root.swatches;
                            selected-index: root.swatch-selected;
                            picked(i) => {
                                root.swatch-selected = i;
                                root.status = "ColorSwatchRow: picked(" + i + ")";
                            }
                        }
                    }
                }
            }

            // ==========================================
            // Category 2: Form Inputs & Selection
            // ==========================================
            CollapsibleSection {
                title: "Form Inputs & Selection";
                expanded: true;

                VerticalLayout {
                    spacing: Tokens.spacing-large;
                    padding-top: Tokens.spacing-small;

                    // DropdownButton
                    VerticalLayout {
                        spacing: Tokens.spacing-small;
                        Text { text: "DropdownButton"; font-weight: 600; font-size: Tokens.font-size-small; color: Tokens.text-secondary; }

                        DropdownButton {
                            text: "Choose a theme";
                            options: ["Light", "Dark", "System"];
                            selected(i) => { root.status = "DropdownButton: selected(" + i + ")"; }
                        }
                    }

                    // OptionSlider
                    VerticalLayout {
                        spacing: Tokens.spacing-small;
                        Text { text: "OptionSlider (Left-to-Thumb Fill)"; font-weight: 600; font-size: Tokens.font-size-small; color: Tokens.text-secondary; }

                        OptionSlider {
                            label: "Volume";
                            minimum: 0;
                            maximum: 1;
                            value: root.slider-value;
                            value-changed(v) => {
                                root.slider-value = v;
                                root.status = "OptionSlider: value-changed(" + Math.round(v * 100) / 100 + ")";
                            }
                        }
                    }

                    // CheckBox & RadioButton
                    VerticalLayout {
                        spacing: Tokens.spacing-small;
                        Text { text: "CheckBox & RadioButton"; font-weight: 600; font-size: Tokens.font-size-small; color: Tokens.text-secondary; }

                        HorizontalLayout {
                            spacing: Tokens.spacing-large;
                            alignment: start;

                            CheckBox {
                                text: "Auto-save changes";
                                checked <=> root.demo-checkbox;
                                toggled(v) => { root.status = "CheckBox: " + (v ? "checked" : "unchecked"); }
                            }

                            RadioButton {
                                text: "Option A";
                                checked: root.demo-radio == 0;
                                clicked => { root.demo-radio = 0; root.status = "RadioButton: Option A"; }
                            }

                            RadioButton {
                                text: "Option B";
                                checked: root.demo-radio == 1;
                                clicked => { root.demo-radio = 1; root.status = "RadioButton: Option B"; }
                            }
                        }
                    }

                    // AppTextField & AppTextArea
                    VerticalLayout {
                        spacing: Tokens.spacing-small;
                        Text { text: "AppTextField & AppTextArea"; font-weight: 600; font-size: Tokens.font-size-small; color: Tokens.text-secondary; }

                        HorizontalLayout {
                            spacing: Tokens.spacing-medium;
                            AppTextField {
                                horizontal-stretch: 1;
                                placeholder-text: "Type search term...";
                                text <=> root.demo-input;
                            }
                        }

                        AppTextArea {
                            placeholder-text: "Multi-line text editor...";
                            height: 70px;
                        }
                    }
                }
            }

            // ==========================================
            // Category 3: Tabs & Navigation
            // ==========================================
            CollapsibleSection {
                title: "Tabs & Navigation";
                expanded: true;

                VerticalLayout {
                    spacing: Tokens.spacing-large;
                    padding-top: Tokens.spacing-small;

                    // Pill Style TabBar
                    VerticalLayout {
                        spacing: Tokens.spacing-small;
                        Text { text: "Pill Style TabBar (Continuous Sliding Indicator)"; font-weight: 600; font-size: Tokens.font-size-small; color: Tokens.text-secondary; }

                        TabBar {
                            tabs: [
                                { id: "overview", title: "Overview", icon: Icons.maximize, has-icon: false, badge: "" },
                                { id: "metrics", title: "Metrics", icon: Icons.maximize, has-icon: false, badge: "LIVE" },
                                { id: "logs", title: "Logs", icon: Icons.maximize, has-icon: false, badge: "9+" },
                                { id: "settings", title: "Settings", icon: Icons.maximize, has-icon: false, badge: "" },
                            ];
                            current-index <=> root.demo-tab;
                            pill-style: true;
                            tab-selected(idx, id) => {
                                root.status = "TabBar: selected " + id + " (index " + idx + ")";
                            }
                        }
                    }

                    // Underline Style TabBar
                    VerticalLayout {
                        spacing: Tokens.spacing-small;
                        Text { text: "Underline Style TabBar"; font-weight: 600; font-size: Tokens.font-size-small; color: Tokens.text-secondary; }

                        TabBar {
                            tabs: [
                                { id: "t1", title: "Editor", icon: Icons.maximize, has-icon: false, badge: "" },
                                { id: "t2", title: "Canvas", icon: Icons.maximize, has-icon: false, badge: "" },
                                { id: "t3", title: "Terminal", icon: Icons.maximize, has-icon: false, badge: "" },
                            ];
                            current-index: 0;
                            pill-style: false;
                        }
                    }

                    // SidebarCategoryList
                    VerticalLayout {
                        spacing: Tokens.spacing-small;
                        Text { text: "SidebarCategoryList"; font-weight: 600; font-size: Tokens.font-size-small; color: Tokens.text-secondary; }

                        SidebarCategoryList {
                            width: 220px;
                            categories: ["General Settings", "Appearance", "Plugins & Extensions"];
                            current-index <=> root.demo-sidebar-idx;
                            selected(idx) => {
                                root.status = "SidebarCategoryList: selected index " + idx;
                            }
                        }
                    }
                }
            }

            // ==========================================
            // Category 4: Feedback, Progress & Cards
            // ==========================================
            CollapsibleSection {
                title: "Feedback, Progress & Cards";
                expanded: true;

                VerticalLayout {
                    spacing: Tokens.spacing-large;
                    padding-top: Tokens.spacing-small;

                    // Badges & Progress
                    VerticalLayout {
                        spacing: Tokens.spacing-small;
                        Text { text: "ProgressBar & Badges"; font-weight: 600; font-size: Tokens.font-size-small; color: Tokens.text-secondary; }

                        ProgressBar {
                            progress: root.demo-progress;
                        }

                        HorizontalLayout {
                            spacing: Tokens.spacing-small;
                            alignment: start;

                            Badge { text: "Active"; variant: "accent"; }
                            Badge { text: "Success"; variant: "success"; }
                            Badge { text: "Error"; variant: "destructive"; }
                            Badge { text: "Draft"; variant: "neutral"; }
                        }
                    }

                    // Card Container
                    Card {
                        raised: true;
                        Text { text: "Card Container (Raised Surface)"; font-weight: 600; color: Tokens.text-primary; }
                        Text { text: "Standard Ayame surface card with elevated backdrop and border."; color: Tokens.text-secondary; font-size: Tokens.font-size-small; }
                    }
                }
            }
        }
    }

    // Status bar at bottom
    Rectangle {
        y: parent.height - 34px;
        width: parent.width;
        height: 34px;
        background: Tokens.surface-raised;
        border-width: Tokens.border-width;
        border-color: Tokens.border;

        HorizontalLayout {
            padding-left: Tokens.spacing-large;
            padding-right: Tokens.spacing-large;
            spacing: Tokens.spacing-medium;
            alignment: center;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Tokens.accent;
            }

            Text {
                text: root.status;
                color: Tokens.text-primary;
                font-size: Tokens.font-size-small;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
    }
}

import { Tokens } from "@origami/tokens.slint";
import {
    SectionLabel,
    AppButton,
    Card,
    CheckBox,
    ProgressBar,
    Badge,
} from "@origami/widgets.slint";

export component SettingsPage inherits Rectangle {
    in-out property <string> current-scheme: "origami";
    in-out property <string> current-variant: "dark";
    in-out property <string> current-accent: "";
    in-out property <string> current-corner-radius: "small";
    in-out property <string> current-border-width: "default";
    in-out property <float> current-ui-scale: 1.0;
    in-out property <string> current-anim-speed: "normal";

    callback set-scheme(string);
    callback set-variant(string);
    callback set-accent(string);
    callback set-corner-radius(string);
    callback set-border-width(string);
    callback set-ui-scale(float);
    callback set-anim-speed(string);
    callback reset-defaults();

    Flickable {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        content-height: content.preferred-height + 40px;

        content := VerticalLayout {
            width: parent.width;
            padding: Tokens.spacing-large;
            spacing: Tokens.spacing-large;

            // Page Header Card
            Rectangle {
                background: Tokens.surface;
                border-radius: Tokens.corner-radius + 2px;
                border-width: Tokens.border-width;
                border-color: Tokens.border-on-surface;

                VerticalLayout {
                    padding: Tokens.spacing-large;
                    spacing: Tokens.spacing-small;

                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: "Theme & Appearance Settings";
                            font-weight: 700;
                            font-size: Tokens.font-size-large + 2px;
                            color: Tokens.text-primary;
                            vertical-alignment: center;
                        }

                        AppButton {
                            text: "デフォルトに戻す";
                            clicked => { root.reset-defaults(); }
                        }
                    }

                    Text {
                        text: "テーマプリセット、アクセントカラー、角丸、枠線幅、UIスケールをリアルタイムに変更できます。";
                        color: Tokens.text-secondary-on-surface;
                        font-size: Tokens.font-size-normal;
                        wrap: word-wrap;
                    }
                }
            }

            // Section 1: Theme Scheme
            Rectangle {
                background: Tokens.surface;
                border-radius: Tokens.corner-radius;
                border-width: Tokens.border-width;
                border-color: Tokens.border-on-surface;

                VerticalLayout {
                    padding: Tokens.spacing-large;
                    spacing: Tokens.spacing-medium;

                    SectionLabel {
                        text: "1. カラーテーマ (Scheme)";
                    }

                    HorizontalLayout {
                        spacing: Tokens.spacing-small;

                        AppButton {
                            text: "Origami";
                            primary: root.current-scheme == "origami";
                            clicked => { root.set-scheme("origami"); }
                        }

                        AppButton {
                            text: "Blender";
                            primary: root.current-scheme == "blender";
                            clicked => { root.set-scheme("blender"); }
                        }

                        AppButton {
                            text: "TokyoNight";
                            primary: root.current-scheme == "tokyonight";
                            clicked => { root.set-scheme("tokyonight"); }
                        }

                        AppButton {
                            text: "Catppuccin";
                            primary: root.current-scheme == "catppuccin";
                            clicked => { root.set-scheme("catppuccin"); }
                        }

                        AppButton {
                            text: "Flexoki";
                            primary: root.current-scheme == "flexoki";
                            clicked => { root.set-scheme("flexoki"); }
                        }
                    }

                    if root.current-scheme == "blender": Rectangle {
                        background: Tokens.surface-raised;
                        border-radius: Tokens.corner-radius;

                        VerticalLayout {
                            padding: Tokens.spacing-medium;

                            Text {
                                text: "Blenderテーマ: DCCツールBlender公式準拠のダークグレー (#303030) とBlenderブルー (#4772b3)。無彩色を基調とした精密な作業用配色です。";
                                color: Tokens.text-secondary-on-raised;
                                font-size: Tokens.font-size-small;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // Section 2: Variant (Light / Dark)
            Rectangle {
                background: Tokens.surface;
                border-radius: Tokens.corner-radius;
                border-width: Tokens.border-width;
                border-color: Tokens.border-on-surface;

                VerticalLayout {
                    padding: Tokens.spacing-large;
                    spacing: Tokens.spacing-medium;

                    SectionLabel {
                        text: "2. バリエーション (Variant)";
                    }

                    HorizontalLayout {
                        spacing: Tokens.spacing-small;

                        AppButton {
                            text: "ダーク (Dark)";
                            primary: root.current-variant == "dark";
                            clicked => { root.set-variant("dark"); }
                        }

                        AppButton {
                            text: "ライト (Light)";
                            primary: root.current-variant == "light";
                            clicked => { root.set-variant("light"); }
                        }
                    }
                }
            }

            // Section 3: Accent Color
            Rectangle {
                background: Tokens.surface;
                border-radius: Tokens.corner-radius;
                border-width: Tokens.border-width;
                border-color: Tokens.border-on-surface;

                VerticalLayout {
                    padding: Tokens.spacing-large;
                    spacing: Tokens.spacing-medium;

                    SectionLabel {
                        text: "3. アクセントカラー (Accent Color)";
                    }

                    HorizontalLayout {
                        spacing: Tokens.spacing-medium;
                        alignment: start;

                        // Preset accent chips
                        AppButton {
                            text: "テーマ標準";
                            primary: root.current-accent == "";
                            clicked => { root.set-accent(""); }
                        }

                        AppButton {
                            text: "Blender Blue (#4772b3)";
                            primary: root.current-accent == "#4772b3";
                            clicked => { root.set-accent("#4772b3"); }
                        }

                        AppButton {
                            text: "Blender Orange (#ed8e26)";
                            primary: root.current-accent == "#ed8e26";
                            clicked => { root.set-accent("#ed8e26"); }
                        }

                        AppButton {
                            text: "Origami Crimson (#d12a55)";
                            primary: root.current-accent == "#d12a55";
                            clicked => { root.set-accent("#d12a55"); }
                        }

                        AppButton {
                            text: "Emerald (#10b981)";
                            primary: root.current-accent == "#10b981";
                            clicked => { root.set-accent("#10b981"); }
                        }
                    }
                }
            }

            // Section 4: Corner Radius & Border Width
            Rectangle {
                background: Tokens.surface;
                border-radius: Tokens.corner-radius;
                border-width: Tokens.border-width;
                border-color: Tokens.border-on-surface;

                VerticalLayout {
                    padding: Tokens.spacing-large;
                    spacing: Tokens.spacing-large;

                    VerticalLayout {
                        spacing: Tokens.spacing-small;
                        SectionLabel {
                            text: "4. コーナー半径 (Corner Radius)";
                        }

                        Text {
                            text: "※ Blenderらしさを出すには「なし (0px)」または「小 (4px)」が最適です。";
                            color: Tokens.text-secondary-on-surface;
                            font-size: Tokens.font-size-small;
                        }

                        HorizontalLayout {
                            spacing: Tokens.spacing-small;

                            AppButton {
                                text: "なし (0px)";
                                primary: root.current-corner-radius == "none";
                                clicked => { root.set-corner-radius("none"); }
                            }

                            AppButton {
                                text: "小 (4px)";
                                primary: root.current-corner-radius == "small";
                                clicked => { root.set-corner-radius("small"); }
                            }

                            AppButton {
                                text: "中 (8px)";
                                primary: root.current-corner-radius == "medium";
                                clicked => { root.set-corner-radius("medium"); }
                            }

                            AppButton {
                                text: "大 (12px)";
                                primary: root.current-corner-radius == "large";
                                clicked => { root.set-corner-radius("large"); }
                            }

                            AppButton {
                                text: "円 (Full)";
                                primary: root.current-corner-radius == "full";
                                clicked => { root.set-corner-radius("full"); }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: Tokens.spacing-small;
                        SectionLabel {
                            text: "5. ボーダー幅 (Border Width)";
                        }

                        Text {
                            text: "※ Blenderらしさを出すには「細 (0.5px)」または「標準 (1px)」が最適です。";
                            color: Tokens.text-secondary-on-surface;
                            font-size: Tokens.font-size-small;
                        }

                        HorizontalLayout {
                            spacing: Tokens.spacing-small;

                            AppButton {
                                text: "細 (0.5px)";
                                primary: root.current-border-width == "thin";
                                clicked => { root.set-border-width("thin"); }
                            }

                            AppButton {
                                text: "標準 (1px)";
                                primary: root.current-border-width == "default";
                                clicked => { root.set-border-width("default"); }
                            }

                            AppButton {
                                text: "太 (2px)";
                                primary: root.current-border-width == "thick";
                                clicked => { root.set-border-width("thick"); }
                            }
                        }
                    }
                }
            }

            // Section 5: UI Scale & Animation
            Rectangle {
                background: Tokens.surface;
                border-radius: Tokens.corner-radius;
                border-width: Tokens.border-width;
                border-color: Tokens.border-on-surface;

                VerticalLayout {
                    padding: Tokens.spacing-large;
                    spacing: Tokens.spacing-large;

                    VerticalLayout {
                        spacing: Tokens.spacing-small;
                        SectionLabel {
                            text: "6. UI スケール (余白・サイズ)";
                        }

                        HorizontalLayout {
                            spacing: Tokens.spacing-small;

                            AppButton {
                                text: "0.8x (Compact)";
                                primary: root.current-ui-scale == 0.8;
                                clicked => { root.set-ui-scale(0.8); }
                            }

                            AppButton {
                                text: "1.0x (Standard)";
                                primary: root.current-ui-scale == 1.0;
                                clicked => { root.set-ui-scale(1.0); }
                            }

                            AppButton {
                                text: "1.2x (Spacious)";
                                primary: root.current-ui-scale == 1.2;
                                clicked => { root.set-ui-scale(1.2); }
                            }

                            AppButton {
                                text: "1.5x (Large)";
                                primary: root.current-ui-scale == 1.5;
                                clicked => { root.set-ui-scale(1.5); }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: Tokens.spacing-small;
                        SectionLabel {
                            text: "7. アニメーション速度";
                        }

                        HorizontalLayout {
                            spacing: Tokens.spacing-small;

                            AppButton {
                                text: "なし (0ms)";
                                primary: root.current-anim-speed == "none";
                                clicked => { root.set-anim-speed("none"); }
                            }

                            AppButton {
                                text: "速い (Fast)";
                                primary: root.current-anim-speed == "fast";
                                clicked => { root.set-anim-speed("fast"); }
                            }

                            AppButton {
                                text: "標準 (Normal)";
                                primary: root.current-anim-speed == "normal";
                                clicked => { root.set-anim-speed("normal"); }
                            }

                            AppButton {
                                text: "遅い (Slow)";
                                primary: root.current-anim-speed == "slow";
                                clicked => { root.set-anim-speed("slow"); }
                            }
                        }
                    }
                }
            }

            // Live Preview Card
            Rectangle {
                background: Tokens.surface;
                border-radius: Tokens.corner-radius;
                border-width: Tokens.border-width;
                border-color: Tokens.border-on-surface;

                VerticalLayout {
                    padding: Tokens.spacing-large;
                    spacing: Tokens.spacing-medium;

                    SectionLabel {
                        text: "ライブプレビュー (Current Theme Preview)";
                    }

                    HorizontalLayout {
                        spacing: Tokens.spacing-medium;
                        alignment: start;

                        AppButton {
                            text: "Primary Button";
                            primary: true;
                        }

                        AppButton {
                            text: "Secondary Button";
                        }

                        AppButton {
                            text: "Destructive Button";
                            destructive: true;
                        }

                        Rectangle {
                            width: 120px;
                            height: 32px;
                            border-radius: Tokens.corner-radius;
                            background: Tokens.surface-raised;
                            border-width: Tokens.border-width;
                            border-color: Tokens.border-on-raised;

                            Text {
                                width: 100%;
                                height: 100%;
                                text: "Surface-Raised";
                                color: Tokens.text-primary;
                                font-size: Tokens.font-size-small;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

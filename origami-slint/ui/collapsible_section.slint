import { Tokens } from "@origami/tokens.slint";
import { Icon, Icons } from "@origami/icons.slint";
import { ToggleSwitch } from "@origami/components.slint";

// Blender property-panel-style collapsible section container.
// Ported from origami/qml/views/CollapsibleSection.qml.
export component CollapsibleSection inherits Rectangle {
    in property <string> title;
    in property <bool> show-toggle: false;
    in-out property <bool> toggle-checked: true;
    callback toggle-requested(bool);
    in-out property <bool> expanded: true;

    background: Tokens.surface;
    border-radius: Tokens.corner-radius;
    border-width: Tokens.border-width;
    border-color: Tokens.border;
    height: header.height + (root.expanded ? body.preferred-height + Tokens.spacing-medium : 0px);
    clip: true;

    animate height { duration: Tokens.anim-short * 1ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1.0); }

    VerticalLayout {
        header := Rectangle {
            height: 36px;
            background: header-touch.has-hover ? Tokens.hover.with-alpha(0.5) : transparent;
            animate background { duration: Tokens.anim-very-short * 1ms; }

            HorizontalLayout {
                padding-left: Tokens.spacing-medium;
                padding-right: Tokens.spacing-medium;
                spacing: Tokens.spacing-small;

                // Chevron icon container
                Rectangle {
                    width: 16px;
                    height: 100%;

                    Icon {
                        y: (parent.height - self.height) / 2;
                        source: root.expanded ? Icons.chevron-down : Icons.chevron-right;
                        color: Tokens.text-primary;
                        width: 14px;
                        height: 14px;
                    }
                }

                // Title text (left aligned, full height vertically centered)
                Text {
                    height: 100%;
                    text: root.title;
                    color: Tokens.text-primary;
                    font-size: Tokens.font-size-normal;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                if root.show-toggle: toggle-wrap := Rectangle {
                    width: 44px;
                    height: 100%;

                    ToggleSwitch {
                        y: (parent.height - self.height) / 2;
                        checked: root.toggle-checked;
                        toggled(checked) => {
                            root.toggle-checked = checked;
                            root.toggle-requested(checked);
                        }
                    }
                }
            }

            header-touch := TouchArea {
                x: 0px;
                y: 0px;
                width: root.show-toggle ? parent.width - 50px : parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { root.expanded = !root.expanded; }
            }
        }

        body := VerticalLayout {
            visible: root.expanded;
            padding-left: Tokens.spacing-medium;
            padding-right: Tokens.spacing-medium;
            padding-bottom: Tokens.spacing-medium;
            spacing: Tokens.spacing-small;
            @children
        }
    }
}

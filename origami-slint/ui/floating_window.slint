import { Tokens } from "@ayame/tokens.slint";
import { Icon, Icons } from "@ayame/icons.slint";

// Slint port of origami/qml/floating/FloatingWindow.qml.
// Draggable, resizable, minimizable floating virtual window widget.
export component FloatingWindow inherits Rectangle {
    in-out property <length> window-x: 40px;
    in-out property <length> window-y: 40px;
    in-out property <length> window-width: 320px;
    in-out property <length> window-height: 240px;

    in property <string> title: "Floating Window";
    in-out property <bool> is-minimized: false;
    in-out property <bool> is-maximized: false;
    in-out property <bool> is-open: true;

    callback closed();
    callback focused();

    // Internal drag state
    property <length> drag-start-x: 0px;
    property <length> drag-start-y: 0px;
    property <length> resize-start-w: 0px;
    property <length> resize-start-h: 0px;

    // Normal restored geometry
    property <length> normal-x: 40px;
    property <length> normal-y: 40px;
    property <length> normal-w: 320px;
    property <length> normal-h: 240px;

    in property <length> host-width: 800px;
    in property <length> host-height: 600px;

    visible: root.is-open;
    x: root.is-maximized ? 0px : root.window-x;
    y: root.is-maximized ? 0px : root.window-y;
    width: root.is-maximized ? root.host-width : max(200px, root.window-width);
    height: root.is-maximized ? root.host-height : (root.is-minimized ? 36px : max(100px, root.window-height));

    background: Tokens.surface-raised;
    border-radius: root.is-maximized ? 0px : Tokens.corner-radius + 2px;
    border-width: Tokens.border-width;
    border-color: Tokens.border;
    clip: true;

    VerticalLayout {
        // Title bar header
        header := Rectangle {
            height: 36px;
            background: header-touch.has-hover ? Tokens.hover : Tokens.surface;
            border-width: Tokens.border-width;
            border-color: Tokens.border;

            HorizontalLayout {
                padding-left: Tokens.spacing-medium;
                padding-right: Tokens.spacing-small;
                spacing: Tokens.spacing-small;
                alignment: center;

                // Window Icon / Indicator
                Rectangle {
                    width: 14px;
                    height: 14px;
                    border-radius: 3px;
                    background: Tokens.accent;

                    Text {
                        text: "W";
                        color: white;
                        font-size: 8px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Window Title
                title-label := Text {
                    text: root.title;
                    color: Tokens.text-primary;
                    font-size: Tokens.font-size-normal;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                // Window Control Buttons (Minimize, Maximize, Close)
                min-btn := Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: min-touch.has-hover ? Tokens.hover : transparent;

                    Text {
                        text: root.is-minimized ? "□" : "—";
                        font-size: 11px;
                        color: Tokens.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    min-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.is-minimized = !root.is-minimized;
                        }
                    }
                }

                max-btn := Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: max-touch.has-hover ? Tokens.hover : transparent;

                    Text {
                        text: root.is-maximized ? "❐" : "▢";
                        font-size: 11px;
                        color: Tokens.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    max-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (!root.is-maximized) {
                                root.normal-x = root.window-x;
                                root.normal-y = root.window-y;
                                root.normal-w = root.window-width;
                                root.normal-h = root.window-height;
                                root.is-maximized = true;
                            } else {
                                root.window-x = root.normal-x;
                                root.window-y = root.normal-y;
                                root.window-width = root.normal-w;
                                root.window-height = root.normal-h;
                                root.is-maximized = false;
                            }
                        }
                    }
                }

                close-btn := Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: close-touch.has-hover ? Tokens.destructive : transparent;

                    Text {
                        text: "✕";
                        font-size: 11px;
                        color: close-touch.has-hover ? white : Tokens.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.is-open = false;
                            root.closed();
                        }
                    }
                }
            }

            header-touch := TouchArea {
                mouse-cursor: move;
                width: parent.width - 80px;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.drag-start-x = self.mouse-x;
                        root.drag-start-y = self.mouse-y;
                        root.focused();
                    }
                }
                moved => {
                    if (self.pressed && !root.is-maximized) {
                        root.window-x += self.mouse-x - root.drag-start-x;
                        root.window-y += self.mouse-y - root.drag-start-y;
                    }
                }
            }
        }

        // Body Content Container
        body := Rectangle {
            visible: !root.is-minimized;
            background: Tokens.surface-raised;
            vertical-stretch: 1;
            clip: true;

            @children

            // Bottom-right Resize Grip Handle
            if !root.is-maximized: resize-handle := Rectangle {
                x: parent.width - 16px;
                y: parent.height - 16px;
                width: 16px;
                height: 16px;
                background: resize-touch.has-hover ? Tokens.accent.transparentize(50%) : transparent;

                Text {
                    text: "◢";
                    font-size: 10px;
                    color: resize-touch.has-hover ? Tokens.accent : Tokens.text-disabled;
                    horizontal-alignment: right;
                    vertical-alignment: bottom;
                }

                resize-touch := TouchArea {
                    mouse-cursor: se-resize;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.resize-start-w = root.window-width;
                            root.resize-start-h = root.window-height;
                            root.drag-start-x = self.mouse-x;
                            root.drag-start-y = self.mouse-y;
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.window-width = max(200px, root.window-width + self.mouse-x - root.drag-start-x);
                            root.window-height = max(100px, root.window-height + self.mouse-y - root.drag-start-y);
                        }
                    }
                }
            }
        }
    }
}

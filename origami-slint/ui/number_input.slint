import { Tokens } from "@origami/tokens.slint";

// Blender-style number field: drag-to-scrub / click-to-edit + step arrows.
// Full Slint port of origami/qml/widgets/inputs/NumberInput.qml.
export component NumberInput inherits Rectangle {
    in-out property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <int> decimals: 0;
    in property <string> label: "";
    in property <string> prefix: "";
    in property <string> suffix: "";
    in property <bool> enabled: true;
    callback value-changed(float);

    property <bool> editing: false;
    property <length> drag-threshold: 3px;
    property <length> press-x: 0px;
    property <float> start-value: 0;
    property <bool> is-dragging: false;

    height: 30px;
    width: 140px;
    background: Tokens.surface;
    border-radius: Tokens.corner-radius;
    border-width: Tokens.border-width;
    border-color: root.editing ? Tokens.accent : (drag-touch.has-hover ? Tokens.border.brighter(0.3) : Tokens.border);
    opacity: root.enabled ? 1.0 : 0.45;
    clip: true;

    animate border-color { duration: Tokens.anim-very-short * 1ms; easing: ease-out; }

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        // Left Step Down Arrow Button (<)
        step-down-rect := Rectangle {
            width: 22px;
            height: parent.height;
            background: step-down-touch.has-hover ? Tokens.hover : transparent;
            animate background { duration: Tokens.anim-very-short * 1ms; }

            Text {
                text: "‹";
                color: root.value <= root.minimum ? Tokens.text-disabled : (step-down-touch.has-hover ? Tokens.text-primary : Tokens.text-secondary);
                font-size: 14px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            step-down-touch := TouchArea {
                enabled: root.enabled && !root.editing && root.value > root.minimum;
                mouse-cursor: self.enabled ? pointer : default;
                clicked => {
                    root.value = max(root.minimum, root.value - root.step);
                    root.value-changed(root.value);
                }
            }
        }

        // Center Scrub / Edit Area
        center-area := Rectangle {
            horizontal-stretch: 1;
            height: parent.height;

            // Display Label / Value when not editing
            if !root.editing: display-text := Text {
                width: 100%;
                height: 100%;
                text: (root.label != "" ? root.label + ": " : "") +
                      (root.prefix != "" ? root.prefix + " " : "") +
                      (root.decimals > 0 ? (Math.round(root.value * Math.pow(10, root.decimals)) / Math.pow(10, root.decimals)) : Math.round(root.value)) +
                      (root.suffix != "" ? " " + root.suffix : "");
                color: Tokens.text-primary;
                font-size: Tokens.font-size-small;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Text Input Field when in edit mode
            if root.editing: edit-input := TextInput {
                width: 100%;
                height: 100%;
                text: root.value;
                color: Tokens.text-primary;
                font-size: Tokens.font-size-small;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                accepted => {
                    root.editing = false;
                }
            }

            drag-touch := TouchArea {
                enabled: root.enabled && !root.editing;
                mouse-cursor: MouseCursor.ew-resize;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.press-x = self.mouse-x;
                        root.start-value = root.value;
                        root.is-dragging = false;
                    }
                    if (event.kind == PointerEventKind.up) {
                        if (!root.is-dragging) {
                            root.editing = true;
                        }
                        root.is-dragging = false;
                    }
                }

                moved => {
                    if (self.pressed) {
                        if (!root.is-dragging && Math.abs(self.mouse-x - root.press-x) >= root.drag-threshold) {
                            root.is-dragging = true;
                        }
                        if (root.is-dragging && center-area.width > 0px) {
                            root.value = max(root.minimum, min(root.maximum, root.start-value + ((self.mouse-x - root.press-x) / center-area.width) * (root.maximum - root.minimum)));
                            root.value-changed(root.value);
                        }
                    }
                }
            }
        }

        // Right Step Up Arrow Button (>)
        step-up-rect := Rectangle {
            width: 22px;
            height: parent.height;
            background: step-up-touch.has-hover ? Tokens.hover : transparent;
            animate background { duration: Tokens.anim-very-short * 1ms; }

            Text {
                text: "›";
                color: root.value >= root.maximum ? Tokens.text-disabled : (step-up-touch.has-hover ? Tokens.text-primary : Tokens.text-secondary);
                font-size: 14px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            step-up-touch := TouchArea {
                enabled: root.enabled && !root.editing && root.value < root.maximum;
                mouse-cursor: self.enabled ? pointer : default;
                clicked => {
                    root.value = min(root.maximum, root.value + root.step);
                    root.value-changed(root.value);
                }
            }
        }
    }
}

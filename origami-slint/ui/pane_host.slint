import { Tokens } from "@ayame/tokens.slint";
import { Icon, Icons } from "@ayame/icons.slint";

export struct PaneCell {
    x: length,
    y: length,
    width: length,
    height: length,
    z: int,
    kind: string,       // "content" | "tab-label" | "tab-add" | "drawer-rail" | "divider" | "group-frame" | "header"
    id: int,
    child-id: int,
    index: int,
    extra: float,
    view-type: string,
    title: string,
    active: bool,
}

export component PaneHost inherits Rectangle {
    in property <[PaneCell]> cells: [];
    in property <int> maximized-leaf-id: -1;
    in property <string> background-image-path: "";
    in property <float> background-pane-opacity: 1.0;
    in property <string> editor-mode: "source";

    callback relayout(length, length);
    callback select-tab(int, int);
    callback close-tab(int, int);
    callback toggle-drawer(int);
    callback convert-group(int);
    callback toggle-maximize(int);
    callback close-leaf(int, int);
    callback detach-leaf(int, int);
    callback header-menu-action(string, string, int); // (view_type, action, pane_id)

    property <bool> drawer-overlay-visible: false;
    property <int> drawer-overlay-drawer-id: -1;
    out property <length> drawer-overlay-x: 0px;
    out property <length> drawer-overlay-y: 0px;
    callback drawer-overlay-opened(int);
    callback drawer-overlay-close-requested();

    callback resize-divider-start(int, int);
    callback resize-divider(int, int, float, float);
    callback resize-divider-end();
    callback tab-drag-ended(int, int, length, length);
    callback drag-hover(length, length);
    callback set-active-leaf(int);

    callback request-picker(string, int, length, length);

    changed width => { root.relayout(root.width, root.height); }
    changed height => { root.relayout(root.width, root.height); }

    property <bool> dragging: false;
    property <string> drag-label: "";
    property <length> drag-x: 0px;
    property <length> drag-y: 0px;
    property <int> drag-armed-group: -1;
    property <int> drag-armed-child: -1;

    in property <string> drop-zone: "";
    in property <length> drop-hl-x: 0px;
    in property <length> drop-hl-y: 0px;
    in property <length> drop-hl-w: 0px;
    in property <length> drop-hl-h: 0px;

    property <length> divider-press-x: 0px;
    property <length> divider-press-y: 0px;

    for cell in root.cells: Rectangle {
        x: cell.x;
        y: cell.y;
        width: cell.width;
        height: cell.height;

        if cell.kind == "divider": TouchArea {
            z: 500;
            x: cell.width < cell.height ? -3px : 0px;
            y: cell.width < cell.height ? 0px : -3px;
            width: cell.width < cell.height ? cell.width + 6px : cell.width;
            height: cell.width < cell.height ? cell.height : cell.height + 6px;
            mouse-cursor: cell.width < cell.height ? MouseCursor.col-resize : MouseCursor.row-resize;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.divider-press-x = cell.x + self.mouse-x;
                    root.divider-press-y = cell.y + self.mouse-y;
                    root.resize-divider-start(cell.id, cell.index);
                }
                if (event.kind == PointerEventKind.move && self.pressed) {
                    if (cell.width < cell.height) {
                        root.resize-divider(cell.id, cell.index, cell.extra, (cell.x + self.mouse-x - root.divider-press-x) / 1px);
                    } else {
                        root.resize-divider(cell.id, cell.index, cell.extra, (cell.y + self.mouse-y - root.divider-press-y) / 1px);
                    }
                }
                if (event.kind == PointerEventKind.up) {
                    root.resize-divider-end();
                }
            }

            Rectangle { background: Tokens.divider; }
        }

        if cell.kind == "group-frame": Rectangle {
            background: transparent;
            border-width: Tokens.border-width;
            border-radius: Tokens.corner-radius;
            border-color: Tokens.border;
        }

        // QML-Faithful PaneHeader Row
        if cell.kind == "header": Rectangle {
            background: root.background-image-path != "" ? Tokens.surface.with-alpha(root.background-pane-opacity) : Tokens.surface;

            // Bottom 1px divider
            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Tokens.divider;
            }

            header-click := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.set-active-leaf(cell.child-id >= 0 ? cell.child-id : cell.id); }
            }

            HorizontalLayout {
                padding-left: Tokens.spacing-small;
                padding-right: Tokens.spacing-small;
                spacing: Tokens.spacing-small;
                alignment: center;

                // 1. Drag Grip
                grip := TouchArea {
                    width: 16px;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.drag-armed-group = cell.child-id;
                            root.drag-armed-child = cell.id;
                            root.set-active-leaf(cell.child-id >= 0 ? cell.child-id : cell.id);
                        }
                        if (event.kind == PointerEventKind.move && self.pressed) {
                            root.dragging = true;
                            root.drag-label = cell.title;
                            root.drag-x = cell.x + self.mouse-x;
                            root.drag-y = cell.y + self.mouse-y;
                            root.drag-hover(root.drag-x, root.drag-y);
                        }
                        if (event.kind == PointerEventKind.up && root.dragging) {
                            root.dragging = false;
                            root.tab-drag-ended(root.drag-armed-group, root.drag-armed-child, root.drag-x, root.drag-y);
                        }
                    }

                    Icon {
                        source: Icons.grip-vertical;
                        color: Tokens.text-secondary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                // 2. View Type Switcher Button (ViewTypePickerButton)
                type-btn := Rectangle {
                    height: 22px;
                    background: type-touch.has-hover ? Tokens.hover : transparent;
                    border-radius: 3px;

                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 4px;
                        alignment: center;

                        Icon {
                            source: cell.view-type == "file-grid" ? Icons.folder : Icons.file;
                            color: Tokens.text-secondary;
                            width: 13px;
                            height: 13px;
                        }

                        Text {
                            text: cell.title;
                            color: Tokens.text-primary;
                            font-size: Tokens.font-size-small;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Icon {
                            source: Icons.chevron-down;
                            color: Tokens.text-secondary;
                            width: 10px;
                            height: 10px;
                        }
                    }

                    type-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.request-picker("change-type", cell.id, cell.x, cell.y + cell.height);
                        }
                    }
                }

                // 3. Mode Switch Dropdown (paneHeaderModeSwitch for TextEditor)
                if cell.view-type == "texteditor": mode-btn := Rectangle {
                    height: 22px;
                    background: mode-touch.has-hover ? Tokens.hover : transparent;
                    border-radius: 3px;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 4px;
                        alignment: center;

                        Text {
                            text: root.editor-mode == "block" ? "ブロック" : "ソース";
                            color: Tokens.text-secondary;
                            font-size: Tokens.font-size-small;
                            vertical-alignment: center;
                        }

                        Icon {
                            source: Icons.chevron-down;
                            color: Tokens.text-secondary;
                            width: 10px;
                            height: 10px;
                        }
                    }

                    mode-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { mode-popup.show(); }
                    }

                    mode-popup := PopupWindow {
                        x: 0px;
                        y: parent.height + 2px;
                        width: 120px;
                        close-policy: PopupClosePolicy.close-on-click-outside;

                        Rectangle {
                            background: Tokens.surface-raised;
                            border-width: Tokens.border-width;
                            border-color: Tokens.border;
                            border-radius: Tokens.corner-radius;

                            VerticalLayout {
                                padding: 4px;
                                spacing: 2px;

                                Rectangle {
                                    height: 24px;
                                    background: (touch-src.has-hover || root.editor-mode == "source") ? Tokens.hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "ソース";
                                            color: root.editor-mode == "source" ? Tokens.accent : Tokens.text-primary;
                                            font-size: Tokens.font-size-small;
                                            font-weight: root.editor-mode == "source" ? 600 : 400;
                                            vertical-alignment: center;
                                        }
                                    }
                                    touch-src := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.header-menu-action("texteditor", "mode-source", cell.id);
                                            mode-popup.close();
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 24px;
                                    background: (touch-blk.has-hover || root.editor-mode == "block") ? Tokens.hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "ブロック";
                                            color: root.editor-mode == "block" ? Tokens.accent : Tokens.text-primary;
                                            font-size: Tokens.font-size-small;
                                            font-weight: root.editor-mode == "block" ? 600 : 400;
                                            vertical-alignment: center;
                                        }
                                    }
                                    touch-blk := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.header-menu-action("texteditor", "mode-block", cell.id);
                                            mode-popup.close();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 4. Pane Header Menus (HeaderMenuGroup)
                // "ファイル" Menu Button (for TextEditor and Board)
                if cell.view-type == "texteditor" || cell.view-type == "board": menu-file-btn := Rectangle {
                    height: 22px;
                    background: file-touch.has-hover ? Tokens.hover : transparent;
                    border-radius: 3px;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        Text {
                            text: "ファイル";
                            color: Tokens.text-secondary;
                            font-size: Tokens.font-size-small;
                            vertical-alignment: center;
                        }
                    }

                    file-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { file-popup.show(); }
                    }

                    file-popup := PopupWindow {
                        x: 0px;
                        y: parent.height + 2px;
                        width: 140px;
                        close-policy: PopupClosePolicy.close-on-click-outside;

                        Rectangle {
                            background: Tokens.surface-raised;
                            border-width: Tokens.border-width;
                            border-color: Tokens.border;
                            border-radius: Tokens.corner-radius;

                            VerticalLayout {
                                padding: 4px;
                                spacing: 2px;

                                if cell.view-type == "board": Rectangle {
                                    height: 24px;
                                    background: touch-save.has-hover ? Tokens.hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "名前を付けて保存...";
                                            color: Tokens.text-primary;
                                            font-size: Tokens.font-size-small;
                                            vertical-alignment: center;
                                        }
                                    }
                                    touch-save := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.header-menu-action("board", "file-save", cell.id);
                                            file-popup.close();
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 24px;
                                    background: touch-open.has-hover ? Tokens.hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "開く...";
                                            color: Tokens.text-primary;
                                            font-size: Tokens.font-size-small;
                                            vertical-alignment: center;
                                        }
                                    }
                                    touch-open := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.header-menu-action(cell.view-type, "file-open", cell.id);
                                            file-popup.close();
                                        }
                                    }
                                }

                                if cell.view-type == "texteditor": Rectangle {
                                    height: 24px;
                                    background: touch-clear.has-hover ? Tokens.destructive.with-alpha(0.3) : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "クリア";
                                            color: touch-clear.has-hover ? Tokens.destructive.brighter(0.4) : Tokens.text-primary;
                                            font-size: Tokens.font-size-small;
                                            vertical-alignment: center;
                                        }
                                    }
                                    touch-clear := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.header-menu-action("texteditor", "file-clear", cell.id);
                                            file-popup.close();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // "追加" Menu Button (for Board)
                if cell.view-type == "board": menu-add-btn := Rectangle {
                    height: 22px;
                    background: add-menu-touch.has-hover ? Tokens.hover : transparent;
                    border-radius: 3px;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        Text {
                            text: "追加";
                            color: Tokens.text-secondary;
                            font-size: Tokens.font-size-small;
                            vertical-alignment: center;
                        }
                    }

                    add-menu-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { add-menu-popup.show(); }
                    }

                    add-menu-popup := PopupWindow {
                        x: 0px;
                        y: parent.height + 2px;
                        width: 150px;
                        close-policy: PopupClosePolicy.close-on-click-outside;

                        Rectangle {
                            background: Tokens.surface-raised;
                            border-width: Tokens.border-width;
                            border-color: Tokens.border;
                            border-radius: Tokens.corner-radius;

                            VerticalLayout {
                                padding: 4px;
                                spacing: 2px;

                                Rectangle {
                                    height: 24px;
                                    background: touch-add-txt.has-hover ? Tokens.hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "テキスト入力を追加";
                                            color: Tokens.text-primary;
                                            font-size: Tokens.font-size-small;
                                            vertical-alignment: center;
                                        }
                                    }
                                    touch-add-txt := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.header-menu-action("board", "add-text-input", cell.id);
                                            add-menu-popup.close();
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 24px;
                                    background: touch-add-img.has-hover ? Tokens.hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "画像を追加";
                                            color: Tokens.text-primary;
                                            font-size: Tokens.font-size-small;
                                            vertical-alignment: center;
                                        }
                                    }
                                    touch-add-img := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.header-menu-action("board", "add-image", cell.id);
                                            add-menu-popup.close();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // "表示" Menu Button (for all views)
                menu-view-btn := Rectangle {
                    height: 22px;
                    background: view-touch.has-hover ? Tokens.hover : transparent;
                    border-radius: 3px;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        Text {
                            text: "表示";
                            color: Tokens.text-secondary;
                            font-size: Tokens.font-size-small;
                            vertical-alignment: center;
                        }
                    }

                    view-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { view-popup.show(); }
                    }

                    view-popup := PopupWindow {
                        x: 0px;
                        y: parent.height + 2px;
                        width: 170px;
                        close-policy: PopupClosePolicy.close-on-click-outside;

                        Rectangle {
                            background: Tokens.surface-raised;
                            border-width: Tokens.border-width;
                            border-color: Tokens.border;
                            border-radius: Tokens.corner-radius;

                            VerticalLayout {
                                padding: 4px;
                                spacing: 2px;

                                Rectangle {
                                    height: 24px;
                                    background: touch-max.has-hover ? Tokens.hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: root.maximized-leaf-id == (cell.child-id >= 0 ? cell.child-id : cell.id) ? "元のレイアウトに戻す" : "ペインを最大化";
                                            color: Tokens.text-primary;
                                            font-size: Tokens.font-size-small;
                                            vertical-alignment: center;
                                        }
                                    }
                                    touch-max := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.toggle-maximize(cell.child-id >= 0 ? cell.child-id : cell.id);
                                            view-popup.close();
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 24px;
                                    background: touch-detach.has-hover ? Tokens.hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "別ウィンドウに移動";
                                            color: Tokens.text-primary;
                                            font-size: Tokens.font-size-small;
                                            vertical-alignment: center;
                                        }
                                    }
                                    touch-detach := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.detach-leaf(cell.id, cell.child-id);
                                            view-popup.close();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Flexible spacer
                Rectangle { horizontal-stretch: 1; }

                // 5. Header End Controls: Maximize, Detach, Close
                maximize-touch := TouchArea {
                    width: 16px;
                    clicked => {
                        root.toggle-maximize(cell.child-id >= 0 ? cell.child-id : cell.id);
                    }

                    Icon {
                        source: root.maximized-leaf-id == (cell.child-id >= 0 ? cell.child-id : cell.id) ? Icons.minimize : Icons.maximize;
                        color: maximize-touch.has-hover ? Tokens.text-primary : Tokens.text-secondary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                detach-touch := TouchArea {
                    width: 16px;
                    clicked => {
                        root.detach-leaf(cell.id, cell.child-id);
                    }

                    Icon {
                        source: Icons.external-link;
                        color: detach-touch.has-hover ? Tokens.text-primary : Tokens.text-secondary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                close-leaf-touch := TouchArea {
                    width: 16px;
                    clicked => {
                        root.close-leaf(cell.id, cell.child-id);
                    }

                    Icon {
                        source: Icons.x;
                        color: close-leaf-touch.has-hover ? Tokens.destructive : Tokens.text-secondary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            if cell.active: Rectangle {
                y: parent.height - 2px;
                width: parent.width;
                height: 2px;
                background: Tokens.accent;
            }
        }

        if cell.kind == "tab-label": Rectangle {
            background: cell.active ? Tokens.hover : Tokens.surface;

            label-touch := TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.drag-armed-group = cell.id;
                        root.drag-armed-child = cell.child-id;
                    }
                    if (event.kind == PointerEventKind.move && self.pressed) {
                        root.dragging = true;
                        root.drag-label = cell.title;
                        root.drag-x = cell.x + self.mouse-x;
                        root.drag-y = cell.y + self.mouse-y;
                        root.drag-hover(root.drag-x, root.drag-y);
                    }
                    if (event.kind == PointerEventKind.up) {
                        if (root.dragging) {
                            root.dragging = false;
                            root.tab-drag-ended(root.drag-armed-group, root.drag-armed-child, root.drag-x, root.drag-y);
                        } else {
                            root.select-tab(cell.id, cell.index);
                        }
                    }
                }
            }

            Text {
                text: cell.title;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Rectangle {
                x: parent.width - self.width - 4px;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                background: close-touch.has-hover ? Tokens.destructive : transparent;
                border-radius: 3px;
                Icon {
                    source: Icons.x;
                    color: white;
                    width: 10px;
                    height: 10px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                close-touch := TouchArea {
                    clicked => { root.close-tab(cell.id, cell.child-id); }
                }
            }
        }

        if cell.kind == "tab-add": Rectangle {
            background: add-touch.has-hover ? Tokens.hover : Tokens.surface;
            VerticalLayout {
                add-touch := TouchArea {
                    vertical-stretch: 1;
                    clicked => {
                        root.request-picker("add-tab", cell.id, cell.x, cell.y + cell.height);
                    }
                    Icon { source: Icons.plus; color: Tokens.text-primary; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                }
                convert-drawer-touch := TouchArea {
                    height: 10px;
                    clicked => { root.convert-group(cell.id); }
                    Icon {
                        source: Icons.switch-horizontal;
                        color: convert-drawer-touch.has-hover ? Tokens.text-primary : Tokens.text-secondary;
                        width: 8px;
                        height: 8px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }

        if cell.kind == "drawer-rail": Rectangle {
            background: rail-touch.has-hover ? Tokens.surface-raised : Tokens.background;
            Text {
                text: cell.title;
                color: Tokens.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            rail-touch := TouchArea {
                mouse-cursor: MouseCursor.move;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.drag-armed-group = -1;
                        root.drag-armed-child = cell.id;
                    }
                    if (event.kind == PointerEventKind.move && self.pressed) {
                        root.dragging = true;
                        root.drag-label = cell.title;
                        root.drag-x = cell.x + self.mouse-x;
                        root.drag-y = cell.y + self.mouse-y;
                        root.drag-hover(root.drag-x, root.drag-y);
                    }
                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                        if (root.dragging) {
                            root.dragging = false;
                            root.tab-drag-ended(root.drag-armed-group, root.drag-armed-child, root.drag-x, root.drag-y);
                        } else if (cell.active) {
                            root.toggle-drawer(cell.id);
                        } else if (root.drawer-overlay-visible && root.drawer-overlay-drawer-id == cell.id) {
                            root.drawer-overlay-visible = false;
                            root.drawer-overlay-close-requested();
                        } else {
                            root.drawer-overlay-drawer-id = cell.id;
                            root.drawer-overlay-x = cell.width < cell.height ? cell.x + cell.width : cell.x;
                            root.drawer-overlay-y = cell.width < cell.height ? cell.y : cell.y + cell.height;
                            root.drawer-overlay-opened(cell.id);
                            root.drawer-overlay-visible = true;
                        }
                    }
                }
            }

            convert-tabs-touch := TouchArea {
                x: parent.width - self.width;
                y: 0;
                width: 12px;
                height: 12px;
                clicked => { root.convert-group(cell.id); }
                Icon {
                    source: Icons.switch-horizontal;
                    color: convert-tabs-touch.has-hover ? Tokens.text-primary : Tokens.text-secondary;
                    width: 8px;
                    height: 8px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }

    if root.dragging && root.drop-zone != "": Rectangle {
        x: root.drop-hl-x;
        y: root.drop-hl-y;
        width: root.drop-hl-w;
        height: root.drop-hl-h;
        z: 998;
        background: root.drop-zone == "center" ? Tokens.selected-surface : Tokens.accent;
        opacity: root.drop-zone == "center" ? 0.55 : 0.9;
    }

    if root.dragging: Rectangle {
        x: root.drag-x - 20px;
        y: root.drag-y - 10px;
        width: 120px;
        height: 24px;
        background: Tokens.surface-raised;
        border-width: Tokens.border-width;
        border-color: white;
        Text { text: root.drag-label; color: white; horizontal-alignment: center; vertical-alignment: center; }
    }
}

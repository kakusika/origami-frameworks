import { Tokens } from "@origami/tokens.slint";
import { Icon, Icons } from "@origami/icons.slint";
import { Bar, BarStart, BarEnd } from "bar.slint";
import { MenuBar, MenuBarMenu, MenuEntry } from "menu_bar.slint";

export struct PaneCell {
    x: length,
    y: length,
    width: length,
    height: length,
    z: int,
    kind: string,       // "content" | "tab-label" | "tab-add" | "drawer-rail" | "divider" | "group-frame" | "header"
    id: int,
    child-id: int,
    index: int,
    extra: float,
    view-type: string,
    title: string,
    active: bool,
    // The view's own header menus (up to 3), shown between the view-type button
    // and the view menu; empty keeps the built-in menus for `texteditor`/`board`.
    // Choosing an entry reports `header-menu-action(view-type, entry id, pane id)`.
    menus: [MenuBarMenu],
}

export component PaneHost inherits Rectangle {
    in property <[PaneCell]> cells: [];
    in property <int> maximized-leaf-id: -1;
    in property <string> background-image-path: "";
    in property <float> background-pane-opacity: 1.0;
    in property <string> editor-mode: "source";

    callback relayout(length, length);
    callback select-tab(int, int);
    callback close-tab(int, int);
    callback toggle-drawer(int);
    callback convert-group(int);
    callback toggle-maximize(int);
    callback close-leaf(int, int);
    callback detach-leaf(int, int);
    callback header-menu-action(string, string, int); // (view_type, action, pane_id)

    property <bool> drawer-overlay-visible: false;
    property <int> drawer-overlay-drawer-id: -1;
    out property <length> drawer-overlay-x: 0px;
    out property <length> drawer-overlay-y: 0px;
    callback drawer-overlay-opened(int);
    callback drawer-overlay-close-requested();

    callback resize-divider-start(int, int);
    callback resize-divider(int, int, float, float);
    callback resize-divider-end();
    callback tab-drag-ended(int, int, length, length);
    callback drag-hover(length, length);
    callback set-active-leaf(int);

    // Entries of the menu behind a leaf's view-type button and a tab strip's
    // "+" button. The app supplies them; choosing one reports
    // (kind, target id, entry id) with kind "change-type" or "add-tab".
    in property <[MenuEntry]> picker-items: [];
    callback picker-picked(string, int, string);

    changed width => { root.relayout(root.width, root.height); }
    changed height => { root.relayout(root.width, root.height); }

    property <bool> dragging: false;
    property <string> drag-label: "";
    property <length> drag-x: 0px;
    property <length> drag-y: 0px;
    property <int> drag-armed-group: -1;
    property <int> drag-armed-child: -1;

    in property <string> drop-zone: "";
    in property <length> drop-hl-x: 0px;
    in property <length> drop-hl-y: 0px;
    in property <length> drop-hl-w: 0px;
    in property <length> drop-hl-h: 0px;

    property <length> divider-press-x: 0px;
    property <length> divider-press-y: 0px;

    pure function entry(id: string, label: string, selected: bool) -> MenuEntry {
        return { id: id, label: label, enabled: true, selected: selected, separator: false };
    }

    pure function menu(id: string, label: string, items: [MenuEntry]) -> MenuBarMenu {
        return { id: id, label: label, icon: @image-url(""), has-icon: false, chevron: false, bold: false, items: items };
    }

    // The menus of a pane header, by view type: the view-type button, then
    // (per type) a mode switch, file and add menus, and a view menu for all.
    pure function header-menus(view-type: string, title: string, mode: string, maximized: bool, extra: [MenuBarMenu]) -> [MenuBarMenu] {
        // App-supplied menus win. Slint cannot concatenate arrays, hence one
        // branch per count (1..3).
        if extra.length == 1 {
            return [type-menu(view-type, title), extra[0], view-menu(maximized)];
        }
        if extra.length == 2 {
            return [type-menu(view-type, title), extra[0], extra[1], view-menu(maximized)];
        }
        if extra.length >= 3 {
            return [type-menu(view-type, title), extra[0], extra[1], extra[2], view-menu(maximized)];
        }
        // texteditor gets a mode switch and a file menu, board a file and an add menu.
        if view-type == "texteditor" {
            return [
                type-menu(view-type, title),
                { id: "mode", label: mode == "block" ? "ブロック" : "ソース", icon: @image-url(""), has-icon: false, chevron: true, bold: false,
                  items: [entry("mode-source", "ソース", mode != "block"), entry("mode-block", "ブロック", mode == "block")] },
                menu("file", "ファイル", [entry("file-open", "開く...", false), entry("file-clear", "クリア", false)]),
                view-menu(maximized),
            ];
        }
        if view-type == "board" {
            return [
                type-menu(view-type, title),
                menu("file", "ファイル", [entry("file-save", "名前を付けて保存...", false), entry("file-open", "開く...", false)]),
                menu("add", "追加", [entry("add-text-input", "テキスト入力を追加", false), entry("add-image", "画像を追加", false)]),
                view-menu(maximized),
            ];
        }
        return [type-menu(view-type, title), view-menu(maximized)];
    }

    pure function type-menu(view-type: string, title: string) -> MenuBarMenu {
        return { id: "type", label: title, icon: view-type == "file-grid" ? Icons.folder : Icons.file, has-icon: true, chevron: true, bold: true, items: root.picker-items };
    }

    pure function view-menu(maximized: bool) -> MenuBarMenu {
        return menu("view", "表示", [
            entry("view-maximize", maximized ? "元のレイアウトに戻す" : "ペインを最大化", false),
            entry("view-detach", "別ウィンドウに移動", false),
        ]);
    }

    for cell in root.cells: Rectangle {
        // Headers and tab strips carry popovers that hang below them; raise
        // them above the other cells so the popovers are not painted over.
        z: (cell.kind == "header" || cell.kind == "tab-add") ? 1000 : 0;
        x: cell.x;
        y: cell.y;
        width: cell.width;
        height: cell.height;

        // The divider fills the gap between two sibling panes. At rest it is
        // three dots (a "you can drag here" hint that does not draw a line
        // between the frames); hovering or dragging replaces them with a
        // colored line.
        if cell.kind == "divider": TouchArea {
            property <bool> vertical: cell.width < cell.height;
            property <bool> active: self.has-hover || self.pressed;

            z: 500;
            width: 100%;
            height: 100%;
            mouse-cursor: self.vertical ? MouseCursor.col-resize : MouseCursor.row-resize;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.divider-press-x = cell.x + self.mouse-x;
                    root.divider-press-y = cell.y + self.mouse-y;
                    root.resize-divider-start(cell.id, cell.index);
                }
                if (event.kind == PointerEventKind.move && self.pressed) {
                    if (cell.width < cell.height) {
                        root.resize-divider(cell.id, cell.index, cell.extra, (cell.x + self.mouse-x - root.divider-press-x) / 1px);
                    } else {
                        root.resize-divider(cell.id, cell.index, cell.extra, (cell.y + self.mouse-y - root.divider-press-y) / 1px);
                    }
                }
                if (event.kind == PointerEventKind.up) {
                    root.resize-divider-end();
                }
            }

            // Hover / drag: the line.
            Rectangle {
                visible: parent.active;
                x: parent.vertical ? (parent.width - self.width) / 2 : 0px;
                y: parent.vertical ? 0px : (parent.height - self.height) / 2;
                width: parent.vertical ? 2px : parent.width;
                height: parent.vertical ? parent.height : 2px;
                border-radius: 1px;
                background: Tokens.accent;
            }

            // At rest: three dots along the divider, centered.
            for i in 3: Rectangle {
                visible: !parent.active;
                width: 3px;
                height: 3px;
                border-radius: 1.5px;
                background: Tokens.text-disabled;
                x: parent.vertical ? (parent.width - self.width) / 2 : (parent.width - 15px) / 2 + i * 6px;
                y: parent.vertical ? (parent.height - 15px) / 2 + i * 6px : (parent.height - self.height) / 2;
            }
        }

        if cell.kind == "group-frame": Rectangle {
            background: transparent;
            border-width: Tokens.border-width;
            border-radius: Tokens.corner-radius;
            border-color: Tokens.border;
        }

        // QML-Faithful PaneHeader Row
        if cell.kind == "header": Rectangle {
            background: root.background-image-path != "" ? Tokens.surface.with-alpha(root.background-pane-opacity) : Tokens.surface;

            // Bottom 1px divider
            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Tokens.divider;
            }

            header-click := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.set-active-leaf(cell.child-id >= 0 ? cell.child-id : cell.id); }
            }

            // start: grip, view type, mode, menus. end: maximize, detach, close.
            Bar {
                width: parent.width;
                height: parent.height;

                BarStart {
                    // 1. Drag Grip
                    grip := TouchArea {
                        width: 16px;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                root.drag-armed-group = cell.child-id;
                                root.drag-armed-child = cell.id;
                                root.set-active-leaf(cell.child-id >= 0 ? cell.child-id : cell.id);
                            }
                            if (event.kind == PointerEventKind.move && self.pressed) {
                                root.dragging = true;
                                root.drag-label = cell.title;
                                root.drag-x = cell.x + self.mouse-x;
                                root.drag-y = cell.y + self.mouse-y;
                                root.drag-hover(root.drag-x, root.drag-y);
                            }
                            if (event.kind == PointerEventKind.up && root.dragging) {
                                root.dragging = false;
                                root.tab-drag-ended(root.drag-armed-group, root.drag-armed-child, root.drag-x, root.drag-y);
                            }
                        }

                        Icon {
                            source: Icons.grip-vertical;
                            color: Tokens.text-secondary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    // 2. The header's menus: view type, mode/file/add, view. They
                    // share one open state, so with one open, hovering another
                    // button opens that one instead.
                    MenuBar {
                        owner: "pane-" + cell.id;
                        container-right: root.absolute-position.x + root.width;
                        menus: root.header-menus(cell.view-type, cell.title, root.editor-mode, root.maximized-leaf-id == (cell.child-id >= 0 ? cell.child-id : cell.id), cell.menus);
                        triggered(menu-id, item-id) => {
                            if menu-id == "type" {
                                root.picker-picked("change-type", cell.id, item-id);
                            } else if item-id == "view-maximize" {
                                root.toggle-maximize(cell.child-id >= 0 ? cell.child-id : cell.id);
                            } else if item-id == "view-detach" {
                                root.detach-leaf(cell.id, cell.child-id);
                            } else {
                                root.header-menu-action(cell.view-type, item-id, cell.id);
                            }
                        }
                    }
                }

                BarEnd {
                    // 5. Header End Controls: Maximize, Detach, Close
                    maximize-touch := TouchArea {
                        width: 16px;
                        clicked => {
                            root.toggle-maximize(cell.child-id >= 0 ? cell.child-id : cell.id);
                        }

                        Icon {
                            source: root.maximized-leaf-id == (cell.child-id >= 0 ? cell.child-id : cell.id) ? Icons.minimize : Icons.maximize;
                            color: maximize-touch.has-hover ? Tokens.text-primary : Tokens.text-secondary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    detach-touch := TouchArea {
                        width: 16px;
                        clicked => {
                            root.detach-leaf(cell.id, cell.child-id);
                        }

                        Icon {
                            source: Icons.external-link;
                            color: detach-touch.has-hover ? Tokens.text-primary : Tokens.text-secondary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    close-leaf-touch := TouchArea {
                        width: 16px;
                        clicked => {
                            root.close-leaf(cell.id, cell.child-id);
                        }

                        Icon {
                            source: Icons.x;
                            color: close-leaf-touch.has-hover ? Tokens.destructive : Tokens.text-secondary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            if cell.active: Rectangle {
                y: parent.height - 2px;
                width: parent.width;
                height: 2px;
                background: Tokens.accent;
            }
        }

        if cell.kind == "tab-label": Rectangle {
            background: cell.active ? Tokens.hover : Tokens.surface;

            label-touch := TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.drag-armed-group = cell.id;
                        root.drag-armed-child = cell.child-id;
                    }
                    if (event.kind == PointerEventKind.move && self.pressed) {
                        root.dragging = true;
                        root.drag-label = cell.title;
                        root.drag-x = cell.x + self.mouse-x;
                        root.drag-y = cell.y + self.mouse-y;
                        root.drag-hover(root.drag-x, root.drag-y);
                    }
                    if (event.kind == PointerEventKind.up) {
                        if (root.dragging) {
                            root.dragging = false;
                            root.tab-drag-ended(root.drag-armed-group, root.drag-armed-child, root.drag-x, root.drag-y);
                        } else {
                            root.select-tab(cell.id, cell.index);
                        }
                    }
                }
            }

            Text {
                text: cell.title;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Rectangle {
                x: parent.width - self.width - 4px;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                background: close-touch.has-hover ? Tokens.destructive : transparent;
                border-radius: 3px;
                Icon {
                    source: Icons.x;
                    color: white;
                    width: 10px;
                    height: 10px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                close-touch := TouchArea {
                    clicked => { root.close-tab(cell.id, cell.child-id); }
                }
            }
        }

        if cell.kind == "tab-add": Rectangle {
            background: Tokens.surface;

            // "+" is centered in the whole cell; the small tabs<->drawer
            // control sits over its bottom-right corner rather than
            // stacking under it, which pushed the "+" up off-center.
            MenuBar {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                owner: "tabs-" + cell.id;
                container-right: root.absolute-position.x + root.width;
                menus: [{ id: "add-tab", label: "", icon: Icons.plus, has-icon: true, chevron: false, bold: false, items: root.picker-items }];
                triggered(menu-id, item-id) => { root.picker-picked("add-tab", cell.id, item-id); }
            }

            convert-drawer-touch := TouchArea {
                x: parent.width - self.width;
                y: parent.height - self.height;
                width: 12px;
                height: 12px;
                clicked => { root.convert-group(cell.id); }
                Icon {
                    source: Icons.switch-horizontal;
                    color: convert-drawer-touch.has-hover ? Tokens.text-primary : Tokens.text-secondary;
                    width: 8px;
                    height: 8px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        if cell.kind == "drawer-rail": Rectangle {
            background: rail-touch.has-hover ? Tokens.surface-raised : Tokens.background;
            Text {
                text: cell.title;
                color: Tokens.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            rail-touch := TouchArea {
                mouse-cursor: MouseCursor.move;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.drag-armed-group = -1;
                        root.drag-armed-child = cell.id;
                    }
                    if (event.kind == PointerEventKind.move && self.pressed) {
                        root.dragging = true;
                        root.drag-label = cell.title;
                        root.drag-x = cell.x + self.mouse-x;
                        root.drag-y = cell.y + self.mouse-y;
                        root.drag-hover(root.drag-x, root.drag-y);
                    }
                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                        if (root.dragging) {
                            root.dragging = false;
                            root.tab-drag-ended(root.drag-armed-group, root.drag-armed-child, root.drag-x, root.drag-y);
                        } else if (cell.active) {
                            root.toggle-drawer(cell.id);
                        } else if (root.drawer-overlay-visible && root.drawer-overlay-drawer-id == cell.id) {
                            root.drawer-overlay-visible = false;
                            root.drawer-overlay-close-requested();
                        } else {
                            root.drawer-overlay-drawer-id = cell.id;
                            root.drawer-overlay-x = cell.width < cell.height ? cell.x + cell.width : cell.x;
                            root.drawer-overlay-y = cell.width < cell.height ? cell.y : cell.y + cell.height;
                            root.drawer-overlay-opened(cell.id);
                            root.drawer-overlay-visible = true;
                        }
                    }
                }
            }

            convert-tabs-touch := TouchArea {
                x: parent.width - self.width;
                y: 0;
                width: 12px;
                height: 12px;
                clicked => { root.convert-group(cell.id); }
                Icon {
                    source: Icons.switch-horizontal;
                    color: convert-tabs-touch.has-hover ? Tokens.text-primary : Tokens.text-secondary;
                    width: 8px;
                    height: 8px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }

    if root.dragging && root.drop-zone != "": Rectangle {
        x: root.drop-hl-x;
        y: root.drop-hl-y;
        width: root.drop-hl-w;
        height: root.drop-hl-h;
        z: 998;
        background: root.drop-zone == "center" ? Tokens.selected-surface : Tokens.accent;
        opacity: root.drop-zone == "center" ? 0.55 : 0.9;
    }

    if root.dragging: Rectangle {
        x: root.drag-x - 20px;
        y: root.drag-y - 10px;
        width: 120px;
        height: 24px;
        background: Tokens.surface-raised;
        border-width: Tokens.border-width;
        border-color: white;
        Text { text: root.drag-label; color: white; horizontal-alignment: center; vertical-alignment: center; }
    }
}

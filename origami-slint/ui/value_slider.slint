import { Tokens } from "tokens.slint";

// Blender-style value slider -- ported from origami/qml/widgets/controls/
// Slider.qml. A single filled bar with no knob and the current value as
// centered text. Not to be confused with `OptionSlider` (components.slint),
// the classic knob slider.
//
// Interaction, same as the QML original:
// - Dragging scrubs the value *relative* to where it was when the press
//   started (crossing the whole bar sweeps the whole minimum..maximum range
//   regardless of where the press landed), snapped to `step` when it is > 0.
// - A press only becomes a drag once the pointer has moved `drag-threshold`;
//   releasing before that opens an inline text field instead.
// - Enter or losing focus commits what was typed (clamped to the range,
//   ignored if it is not a number); Escape cancels.
//
// `value` is `in-out` like the other inputs, and `value-changed` fires on
// every change the user makes.
export component ValueSlider inherits Rectangle {
    in-out property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 0;
    in property <int> decimals: 2;
    in property <string> label: "";
    in property <bool> enabled: true;
    in property <length> drag-threshold: 3px;
    callback value-changed(float);

    property <bool> editing: false;
    property <length> press-x: 0px;
    property <float> start-value: 0;
    property <bool> is-dragging: false;
    property <float> progress: root.maximum > root.minimum ? max(0.0, min(1.0, (root.value - root.minimum) / (root.maximum - root.minimum))) : 0.0;

    function clamp-value(v: float) -> float {
        return max(root.minimum, min(root.maximum, v));
    }

    function set-value(v: float) {
        root.value = root.clamp-value(v);
        root.value-changed(root.value);
    }

    height: 24px;
    min-width: 96px;
    background: Tokens.surface;
    border-radius: Tokens.corner-radius;
    border-width: Tokens.border-width;
    border-color: root.editing ? Tokens.accent : Tokens.border;
    opacity: root.enabled ? 1.0 : 0.4;
    // A straight-edged fill inside a rounded, clipping track keeps the
    // fill's left corners exactly on the track's own curve at any amount.
    clip: true;

    animate border-color { duration: Tokens.anim-very-short * 1ms; easing: ease-out; }

    // Filled portion. No hover shade; only a held press darkens it.
    Rectangle {
        x: 0px;
        width: parent.width * root.progress;
        height: parent.height;
        background: touch.pressed ? Tokens.accent.darker(0.2) : Tokens.accent;
    }

    if !root.editing: Text {
        width: 100%;
        height: 100%;
        text: (root.label != "" ? root.label + ": " : "") + root.value.to-fixed(root.decimals);
        color: Tokens.text-primary;
        font-size: Tokens.font-size-small;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.editing: edit := TextInput {
        width: 100%;
        height: 100%;
        text: root.value.to-fixed(root.decimals);
        color: Tokens.text-primary;
        font-size: Tokens.font-size-small;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        input-type: text;

        init => {
            self.focus();
            self.select-all();
        }

        accepted => {
            if (self.text.is-float()) {
                root.set-value(self.text.to-float());
            }
            root.editing = false;
        }

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.editing = false;
                return accept;
            }
            return reject;
        }

        changed has-focus => {
            // Clicking away commits, like the QML field's onEditingFinished.
            if (!self.has-focus && root.editing) {
                if (self.text.is-float()) {
                    root.set-value(self.text.to-float());
                }
                root.editing = false;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled && !root.editing;
        mouse-cursor: MouseCursor.ew-resize;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.press-x = self.mouse-x;
                root.start-value = root.value;
                root.is-dragging = false;
            }
            if (event.kind == PointerEventKind.up) {
                if (!root.is-dragging) {
                    root.editing = true;
                }
                root.is-dragging = false;
            }
        }

        moved => {
            if (self.pressed) {
                if (!root.is-dragging && abs(self.mouse-x - root.press-x) >= root.drag-threshold) {
                    root.is-dragging = true;
                }
                if (root.is-dragging && root.width > 0px) {
                    // Relative to the value at press time, not the cursor's
                    // absolute position over the bar.
                    // `step` == 0 means continuous; a bare `round(x / step)`
                    // would divide by zero.
                    let raw = root.start-value + ((self.mouse-x - root.press-x) / root.width) * (root.maximum - root.minimum);
                    root.set-value(root.step > 0 ? round(raw / root.step) * root.step : raw);
                }
            }
        }
    }
}

import { Tokens } from "@origiri/tokens.slint";
import {
    AppButton,
    CollapsibleSection,
    ColorSwatchRow,
} from "@origiri/widgets.slint";

export component SettingsPage inherits Rectangle {
    property <string> status: "Pick an option below to see it applied live.";

    in-out property <string> current-scheme: "origiri";
    in-out property <string> current-variant: "dark";
    in-out property <string> current-accent: "";
    in-out property <bool> current-accent-is-system: false;
    in-out property <string> current-corner-radius: "small";
    in-out property <string> current-border-width: "default";
    in-out property <float> current-ui-scale: 1.0;
    in-out property <string> current-anim-speed: "normal";
    in-out property <bool> system-scheme-available: false;

    callback set-scheme(string);
    callback set-variant(string);
    callback set-accent(string);
    callback set-accent-system();
    callback set-corner-radius(string);
    callback set-border-width(string);
    callback set-ui-scale(float);
    callback set-anim-speed(string);
    callback reset-defaults();

    property <[string]> accent-hexes: ["#4772b3", "#ed8e26", "#d12a55", "#10b981"];
    property <[color]> accent-colors: [#4772b3, #ed8e26, #d12a55, #10b981];

    Flickable {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height - 34px;
        content-height: content.preferred-height + 24px;

        content := VerticalLayout {
            width: parent.width;
            padding: Tokens.spacing-large;
            spacing: Tokens.spacing-large;

            // Page Header Card
            Rectangle {
                background: Tokens.surface;
                border-radius: Tokens.corner-radius + 2px;
                border-width: Tokens.border-width;
                border-color: Tokens.border-on-surface;

                VerticalLayout {
                    padding: Tokens.spacing-large;
                    spacing: Tokens.spacing-small;

                    HorizontalLayout {
                        spacing: Tokens.spacing-small;

                        Text {
                            text: "Theme & Appearance Settings";
                            font-weight: 700;
                            font-size: Tokens.font-size-large + 2px;
                            color: Tokens.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        AppButton {
                            text: "デフォルトに戻す";
                            clicked => {
                                root.reset-defaults();
                                root.status = "Reset to defaults";
                            }
                        }
                    }

                    Text {
                        text: "テーマプリセット、アクセントカラー、角丸、枠線幅、UIスケールをリアルタイムに変更できます。";
                        color: Tokens.text-secondary-on-surface;
                        font-size: Tokens.font-size-normal;
                        wrap: word-wrap;
                    }
                }
            }

            // Section 1: Theme Scheme
            CollapsibleSection {
                title: "1. カラーテーマ (Scheme)";
                expanded: true;

                HorizontalLayout {
                    spacing: Tokens.spacing-small;

                    if root.system-scheme-available: AppButton {
                        text: "システム (System)";
                        primary: root.current-scheme == "system";
                        clicked => {
                            root.set-scheme("system");
                            root.status = "Scheme: System";
                        }
                    }

                    AppButton {
                        text: "Origiri";
                        primary: root.current-scheme == "origiri";
                        clicked => {
                            root.set-scheme("origiri");
                            root.status = "Scheme: Origiri";
                        }
                    }

                    AppButton {
                        text: "Blender";
                        primary: root.current-scheme == "blender";
                        clicked => {
                            root.set-scheme("blender");
                            root.status = "Scheme: Blender";
                        }
                    }

                    AppButton {
                        text: "TokyoNight";
                        primary: root.current-scheme == "tokyonight";
                        clicked => {
                            root.set-scheme("tokyonight");
                            root.status = "Scheme: TokyoNight";
                        }
                    }

                    AppButton {
                        text: "Catppuccin";
                        primary: root.current-scheme == "catppuccin";
                        clicked => {
                            root.set-scheme("catppuccin");
                            root.status = "Scheme: Catppuccin";
                        }
                    }

                    AppButton {
                        text: "Flexoki";
                        primary: root.current-scheme == "flexoki";
                        clicked => {
                            root.set-scheme("flexoki");
                            root.status = "Scheme: Flexoki";
                        }
                    }
                }

                if root.current-scheme == "blender": Rectangle {
                    background: Tokens.surface-raised;
                    border-radius: Tokens.corner-radius;

                    VerticalLayout {
                        padding: Tokens.spacing-medium;

                        Text {
                            text: "Blenderテーマ: DCCツールBlender公式準拠のダークグレー (#303030) とBlenderブルー (#4772b3)。無彩色を基調とした精密な作業用配色です。";
                            color: Tokens.text-secondary-on-raised;
                            font-size: Tokens.font-size-small;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Section 2: Variant (Light / Dark)
            CollapsibleSection {
                title: "2. バリエーション (Variant)";
                expanded: true;

                HorizontalLayout {
                    spacing: Tokens.spacing-small;

                    AppButton {
                        text: "ダーク (Dark)";
                        primary: root.current-variant == "dark";
                        clicked => {
                            root.set-variant("dark");
                            root.status = "Variant: Dark";
                        }
                    }

                    AppButton {
                        text: "ライト (Light)";
                        primary: root.current-variant == "light";
                        clicked => {
                            root.set-variant("light");
                            root.status = "Variant: Light";
                        }
                    }
                }
            }

            // Section 3: Accent Color
            CollapsibleSection {
                title: "3. アクセントカラー (Accent Color)";
                expanded: true;

                HorizontalLayout {
                    spacing: Tokens.spacing-medium;
                    alignment: start;

                    AppButton {
                        text: "システム (System)";
                        primary: root.current-accent-is-system;
                        clicked => {
                            root.set-accent-system();
                            root.status = "Accent: System";
                        }
                    }

                    AppButton {
                        text: "テーマ標準";
                        primary: !root.current-accent-is-system && root.current-accent == "";
                        clicked => {
                            root.set-accent("");
                            root.status = "Accent: theme default";
                        }
                    }

                    ColorSwatchRow {
                        swatches: root.accent-colors;
                        selected-index: root.current-accent-is-system ? -1
                            : root.accent-hexes[0] == root.current-accent ? 0
                            : root.accent-hexes[1] == root.current-accent ? 1
                            : root.accent-hexes[2] == root.current-accent ? 2
                            : root.accent-hexes[3] == root.current-accent ? 3
                            : -1;
                        picked(i) => {
                            root.set-accent(root.accent-hexes[i]);
                            root.status = "Accent: " + root.accent-hexes[i];
                        }
                    }
                }
            }

            // Section 4: Corner Radius
            CollapsibleSection {
                title: "4. コーナー半径 (Corner Radius)";
                expanded: true;

                Text {
                    text: "※ Blenderらしさを出すには「なし (0px)」または「小 (4px)」が最適です。";
                    color: Tokens.text-secondary-on-surface;
                    font-size: Tokens.font-size-small;
                }

                HorizontalLayout {
                    spacing: Tokens.spacing-small;

                    AppButton {
                        text: "なし (0px)";
                        primary: root.current-corner-radius == "none";
                        clicked => {
                            root.set-corner-radius("none");
                            root.status = "Corner Radius: none (0px)";
                        }
                    }

                    AppButton {
                        text: "小 (4px)";
                        primary: root.current-corner-radius == "small";
                        clicked => {
                            root.set-corner-radius("small");
                            root.status = "Corner Radius: small (4px)";
                        }
                    }

                    AppButton {
                        text: "中 (8px)";
                        primary: root.current-corner-radius == "medium";
                        clicked => {
                            root.set-corner-radius("medium");
                            root.status = "Corner Radius: medium (8px)";
                        }
                    }

                    AppButton {
                        text: "大 (12px)";
                        primary: root.current-corner-radius == "large";
                        clicked => {
                            root.set-corner-radius("large");
                            root.status = "Corner Radius: large (12px)";
                        }
                    }

                    AppButton {
                        text: "円 (Full)";
                        primary: root.current-corner-radius == "full";
                        clicked => {
                            root.set-corner-radius("full");
                            root.status = "Corner Radius: full";
                        }
                    }
                }
            }

            // Section 5: Border Width
            CollapsibleSection {
                title: "5. ボーダー幅 (Border Width)";
                expanded: true;

                Text {
                    text: "※ Blenderらしさを出すには「細 (0.5px)」または「標準 (1px)」が最適です。";
                    color: Tokens.text-secondary-on-surface;
                    font-size: Tokens.font-size-small;
                }

                HorizontalLayout {
                    spacing: Tokens.spacing-small;

                    AppButton {
                        text: "なし (0px)";
                        primary: root.current-border-width == "none";
                        clicked => {
                            root.set-border-width("none");
                            root.status = "Border Width: none (0px)";
                        }
                    }

                    AppButton {
                        text: "細 (0.5px)";
                        primary: root.current-border-width == "thin";
                        clicked => {
                            root.set-border-width("thin");
                            root.status = "Border Width: thin (0.5px)";
                        }
                    }

                    AppButton {
                        text: "標準 (1px)";
                        primary: root.current-border-width == "default";
                        clicked => {
                            root.set-border-width("default");
                            root.status = "Border Width: default (1px)";
                        }
                    }

                    AppButton {
                        text: "太 (2px)";
                        primary: root.current-border-width == "thick";
                        clicked => {
                            root.set-border-width("thick");
                            root.status = "Border Width: thick (2px)";
                        }
                    }
                }
            }

            // Section 6: UI Scale
            CollapsibleSection {
                title: "6. UI スケール (余白・サイズ)";
                expanded: true;

                HorizontalLayout {
                    spacing: Tokens.spacing-small;

                    AppButton {
                        text: "0.8x";
                        primary: root.current-ui-scale == 0.8;
                        clicked => {
                            root.set-ui-scale(0.8);
                            root.status = "UI Scale: 0.8x (Compact)";
                        }
                    }

                    AppButton {
                        text: "1.0x";
                        primary: root.current-ui-scale == 1.0;
                        clicked => {
                            root.set-ui-scale(1.0);
                            root.status = "UI Scale: 1.0x (Standard)";
                        }
                    }

                    AppButton {
                        text: "1.2x";
                        primary: root.current-ui-scale == 1.2;
                        clicked => {
                            root.set-ui-scale(1.2);
                            root.status = "UI Scale: 1.2x (Spacious)";
                        }
                    }

                    AppButton {
                        text: "1.5x";
                        primary: root.current-ui-scale == 1.5;
                        clicked => {
                            root.set-ui-scale(1.5);
                            root.status = "UI Scale: 1.5x (Large)";
                        }
                    }
                }
            }

            // Section 7: Animation Speed
            CollapsibleSection {
                title: "7. アニメーション速度";
                expanded: true;

                HorizontalLayout {
                    spacing: Tokens.spacing-small;

                    AppButton {
                        text: "なし (0ms)";
                        primary: root.current-anim-speed == "none";
                        clicked => {
                            root.set-anim-speed("none");
                            root.status = "Animation Speed: none (0ms)";
                        }
                    }

                    AppButton {
                        text: "速い (Fast)";
                        primary: root.current-anim-speed == "fast";
                        clicked => {
                            root.set-anim-speed("fast");
                            root.status = "Animation Speed: fast";
                        }
                    }

                    AppButton {
                        text: "標準 (Normal)";
                        primary: root.current-anim-speed == "normal";
                        clicked => {
                            root.set-anim-speed("normal");
                            root.status = "Animation Speed: normal";
                        }
                    }

                    AppButton {
                        text: "遅い (Slow)";
                        primary: root.current-anim-speed == "slow";
                        clicked => {
                            root.set-anim-speed("slow");
                            root.status = "Animation Speed: slow";
                        }
                    }
                }
            }

            // Live Preview Section
            CollapsibleSection {
                title: "ライブプレビュー (Current Theme Preview)";
                expanded: true;

                HorizontalLayout {
                    spacing: Tokens.spacing-medium;
                    alignment: start;

                    AppButton {
                        text: "Primary Button";
                        primary: true;
                        clicked => { root.status = "Preview: Primary Button clicked"; }
                    }

                    AppButton {
                        text: "Secondary Button";
                        clicked => { root.status = "Preview: Secondary Button clicked"; }
                    }

                    AppButton {
                        text: "Destructive Button";
                        destructive: true;
                        clicked => { root.status = "Preview: Destructive Button clicked"; }
                    }

                    Rectangle {
                        width: 120px;
                        height: 32px;
                        border-radius: Tokens.corner-radius;
                        background: Tokens.surface-raised;
                        border-width: Tokens.border-width;
                        border-color: Tokens.border-on-raised;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: "Surface-Raised";
                            color: Tokens.text-primary;
                            font-size: Tokens.font-size-small;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // Status bar at bottom, matching the other gallery pages.
    Rectangle {
        y: parent.height - 34px;
        width: parent.width;
        height: 34px;
        background: Tokens.surface-raised;
        border-width: Tokens.border-width;
        border-color: Tokens.border-on-raised;

        HorizontalLayout {
            padding-left: Tokens.spacing-large;
            padding-right: Tokens.spacing-large;
            spacing: Tokens.spacing-medium;
            alignment: center;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Tokens.accent;
            }

            Text {
                text: root.status;
                color: Tokens.text-primary;
                font-size: Tokens.font-size-small;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
    }
}
